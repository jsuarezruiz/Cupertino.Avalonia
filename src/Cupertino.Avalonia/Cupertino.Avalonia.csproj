<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Cupertino</RootNamespace>
    <AssemblyName>Cupertino.Avalonia</AssemblyName>
    <PackageId>Cupertino.Avalonia</PackageId>
    <Authors>Javier Suárez Ruiz</Authors>
    <Description>An iOS 26 design system for Avalonia with control themes, typography, colour, motion, custom controls and Liquid Glass.</Description>
    <Version>0.1.0-preview.1</Version>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/jsuarezruiz/Cupertino.Avalonia</PackageProjectUrl>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/jsuarezruiz/Cupertino.Avalonia</RepositoryUrl>
    <PackageReadmeFile>README.NuGet.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Public API documentation is incomplete. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.1" />
    <PackageReference Include="Avalonia.Controls.ColorPicker" Version="12.1.1" />
    <PackageReference Include="Avalonia.Skia" Version="12.1.1" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../README.NuGet.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Cupertino.Avalonia.Tests" />
  </ItemGroup>

</Project>
