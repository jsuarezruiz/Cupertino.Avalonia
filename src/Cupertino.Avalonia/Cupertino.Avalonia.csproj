<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Cupertino</RootNamespace>
    <AssemblyName>Cupertino.Avalonia</AssemblyName>
    <IsPackable>true</IsPackable>
    <PackageId>Cupertino.Avalonia</PackageId>
    <Title>Cupertino Avalonia</Title>
    <Authors>Javier Suárez Ruiz</Authors>
    <Company>Javier Suárez Ruiz</Company>
    <Description>An iOS 26 design system for Avalonia with control themes, typography, colour, motion, custom controls and Liquid Glass.</Description>
    <Copyright>Copyright © 2026 Javier Suárez Ruiz</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/jsuarezruiz/Cupertino.Avalonia</PackageProjectUrl>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/jsuarezruiz/Cupertino.Avalonia.git</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>package-icon.png</PackageIcon>
    <PackageTags>avalonia avaloniaui cupertino ios liquid-glass controls themes cross-platform</PackageTags>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <WarningsAsErrors>$(WarningsAsErrors);CS1591</WarningsAsErrors>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EnablePackageValidation>true</EnablePackageValidation>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <!-- Apple system-font integration wraps Avalonia's current text shaper. -->
    <AvaloniaAccessUnstablePrivateApis>true</AvaloniaAccessUnstablePrivateApis>
    <!-- Keep the explicit compatibility warning visible without making the
         package's intentional adapter fail warning-as-error release builds. -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);AVA3001</WarningsNotAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.1" />
    <PackageReference Include="Avalonia.Controls.ColorPicker" Version="12.1.1" />
    <PackageReference Include="Avalonia.Skia" Version="12.1.1" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../README.NuGet.md" Pack="true" PackagePath="README.md" />
    <None Include="../../samples/Cupertino.Gallery/Assets/AppIcon.png" Pack="true" PackagePath="package-icon.png" />
    <None Include="../../LICENSE" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Cupertino.Avalonia.Tests" />
  </ItemGroup>

</Project>
