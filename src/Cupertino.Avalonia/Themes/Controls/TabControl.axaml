<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:Cupertino.Controls">


  <ControlTheme x:Key="CupertinoSegmentTravelLens" TargetType="controls:GlassSurface">
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="BlurRadius" Value="0" />
    <Setter Property="GlassThickness" Value="5" />
    <Setter Property="RefractionStrength" Value="8" />
    <Setter Property="ChromaticAberration" Value="0.25" />
    <Setter Property="DepthEffect" Value="0.06" />
    <Setter Property="Saturation" Value="1.1" />
    <Setter Property="LightIntensity" Value="0.6" />
    <Setter Property="FresnelStrength" Value="0.55" />
    <Setter Property="ShadowOpacity" Value="0.08" />
    <Setter Property="ShadowBlur" Value="5" />
    <Setter Property="ShadowOffset" Value="2" />
    <Setter Property="IsAdaptive" Value="False" />
    <Setter Property="Magnification" Value="1.025" />
    <Setter Property="Tint" Value="{DynamicResource CupertinoSegmentLensTint}" />
  </ControlTheme>

  <ControlTheme x:Key="CupertinoBottomRestingLens" TargetType="controls:GlassSurface">
    <!-- Native keeps the selected lens ~4pt inside the bar while three-tab
         centres sit 86pt apart: a 92pt lens overlaps its cell by 3pt per side. -->
    <Setter Property="Margin" Value="-3,4.5" />
    <Setter Property="CornerRadius" Value="26.5" />
    <Setter Property="BlurRadius" Value="4" />
    <Setter Property="GlassThickness" Value="5" />
    <Setter Property="RefractionStrength" Value="9" />
    <Setter Property="ChromaticAberration" Value="0.3" />
    <Setter Property="DepthEffect" Value="0.1" />
    <Setter Property="Saturation" Value="1.3" />
    <Setter Property="LightIntensity" Value="0.3" />
    <Setter Property="FresnelStrength" Value="0.12" />
    <Setter Property="IsAdaptive" Value="False" />
    <Setter Property="Magnification" Value="1.04" />
    <Setter Property="Tint" Value="{DynamicResource CupertinoTabLensTint}" />
    <Setter Property="ShadowOpacity" Value="0.035" />
    <Setter Property="ShadowBlur" Value="6" />
    <Setter Property="ShadowOffset" Value="1.5" />
  </ControlTheme>

  <ControlTheme x:Key="CupertinoBottomTravelLens" TargetType="controls:GlassSurface">
    <Setter Property="Height" Value="62" />
    <Setter Property="CornerRadius" Value="31" />
    <Setter Property="BlurRadius" Value="0" />
    <Setter Property="GlassThickness" Value="9" />
    <Setter Property="RefractionStrength" Value="30" />
    <Setter Property="ChromaticAberration" Value="1.1" />
    <Setter Property="DepthEffect" Value="0.18" />
    <Setter Property="Saturation" Value="1.25" />
    <Setter Property="LightIntensity" Value="0.35" />
    <Setter Property="FresnelStrength" Value="0.5" />
    <Setter Property="ShadowOpacity" Value="0.07" />
    <Setter Property="ShadowBlur" Value="14" />
    <Setter Property="ShadowOffset" Value="3" />
    <Setter Property="IsAdaptive" Value="False" />
    <Setter Property="Magnification" Value="1.18" />
    <Setter Property="Tint" Value="{DynamicResource CupertinoTabPillTint}" />
  </ControlTheme>

  <ControlTheme x:Key="CupertinoBottomBarSurface" TargetType="controls:GlassSurface">
    <Setter Property="Height" Value="62" />
    <Setter Property="CornerRadius" Value="31" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="BlurRadius" Value="18" />
    <Setter Property="GlassThickness" Value="8" />
    <Setter Property="Saturation" Value="1.8" />
    <Setter Property="RefractionStrength" Value="8" />
    <Setter Property="LightIntensity" Value="0.5" />
    <Setter Property="FresnelStrength" Value="0.55" />
    <Setter Property="Tint" Value="{DynamicResource CupertinoTabBarTint}" />
    <Setter Property="ShadowOpacity" Value="0.06" />
    <Setter Property="ShadowBlur" Value="11" />
    <Setter Property="ShadowOffset" Value="3" />
  </ControlTheme>

  <ControlTheme x:Key="CupertinoSegmentedTabItem" TargetType="TabItem">
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="Foreground" Value="{DynamicResource CupertinoLabelBrush}" />
    <Setter Property="FontSize" Value="{DynamicResource CupertinoFontSize13}" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel>
          <Border x:Name="Pill"
                  CornerRadius="14"
                  Margin="2"
                  Opacity="0"
                  Background="{DynamicResource CupertinoSegmentSelectedBrush}">
            <Border.Transitions>
              <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
              </Transitions>
            </Border.Transitions>
          </Border>
          <Border x:Name="FocusRing"
                  BorderBrush="{DynamicResource CupertinoFocusRingBrush}"
                  BorderThickness="2"
                  CornerRadius="16"
                  Margin="1"
                  IsVisible="False" />
          <ContentPresenter x:Name="PART_ContentPresenter"
                            Content="{TemplateBinding Header}"
                            ContentTemplate="{TemplateBinding HeaderTemplate}"
                            Padding="{TemplateBinding Padding}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
        </Panel>
      </ControlTemplate>
    </Setter>

    <Style Selector="^:selected /template/ Border#Pill">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="^.cupertino-nopill /template/ Border#Pill">
      <Setter Property="Opacity" Value="0" />
    </Style>
    <Style Selector="^:selected">
      <Setter Property="FontWeight" Value="Medium" />
    </Style>
    <Style Selector="^:pointerover:not(:selected) /template/ Border#Pill">
      <Setter Property="Opacity" Value="0.35" />
    </Style>
    <Style Selector="^:pressed">
      <Setter Property="Opacity" Value="0.6" />
    </Style>
    <Style Selector="^:focus-visible /template/ Border#FocusRing">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Opacity" Value="0.4" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="CupertinoAccessoryButton" TargetType="Button">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Width" Value="44" />
    <Setter Property="Height" Value="44" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.12" />
      </Transitions>
    </Setter>
    <Setter Property="Template">
      <ControlTemplate>
        <Panel Background="Transparent">
          <ContentPresenter Content="{TemplateBinding Content}"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center" />
          <Border x:Name="FocusRing"
                  CornerRadius="999" Margin="-2"
                  BorderBrush="{DynamicResource CupertinoFocusRingBrush}"
                  BorderThickness="2" Opacity="0" />
        </Panel>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pressed">
      <Setter Property="Opacity" Value="0.4" />
    </Style>
    <Style Selector="^:focus-visible /template/ Border#FocusRing">
      <Setter Property="Opacity" Value="1" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="CupertinoBottomTabItem" TargetType="TabItem">
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="ClipToBounds" Value="False" />
    <Setter Property="Foreground" Value="{DynamicResource CupertinoLabelBrush}" />
    <Setter Property="FontSize" Value="{DynamicResource CupertinoFontSize10}" />
    <Setter Property="LetterSpacing" Value="0.25" />
    <!-- iOS 26.2: three visible tabs are centred 86pt apart. -->
    <Setter Property="Width" Value="86" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel Background="Transparent" ClipToBounds="False">
          <!-- Use visibility to avoid sampling a half-faded lens. -->
          <controls:GlassSurface x:Name="Lens"
                                 IsVisible="False"
                                 Theme="{StaticResource CupertinoBottomRestingLens}" />
          <Border x:Name="Hover"
                  CornerRadius="26.5"
                  Margin="-3,4.5"
                  Opacity="0"
                  Background="{DynamicResource CupertinoTabPillBrush}">
            <Border.Transitions>
              <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.18" />
              </Transitions>
            </Border.Transitions>
          </Border>
          <Border x:Name="FocusRing"
                  BorderBrush="{DynamicResource CupertinoFocusRingBrush}"
                  BorderThickness="2"
                  CornerRadius="16"
                  Margin="1"
                  IsVisible="False" />
          <ContentPresenter x:Name="PART_ContentPresenter"
                            Content="{TemplateBinding Header}"
                            ContentTemplate="{TemplateBinding HeaderTemplate}"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center" />
          <controls:CupertinoBadge
              Classes="tab-badge"
              IsVisible="{Binding (controls:Tabs.BadgeValue), RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static ObjectConverters.IsNotNull}}"
              Value="{Binding (controls:Tabs.BadgeValue), RelativeSource={RelativeSource TemplatedParent}, TargetNullValue=-1}"
              HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Panel>
      </ControlTemplate>
    </Setter>

    <!-- iOS compacts a two-destination bar to 118pt: 8 + (2 x 51) + 8.
         The 59pt lens overlaps its item cell by 4pt on each side. -->
    <Style Selector="^.cupertino-two-item">
      <Setter Property="Width" Value="51" />
    </Style>
    <Style Selector="^.cupertino-two-item /template/ controls|GlassSurface#Lens">
      <Setter Property="Margin" Value="-4,4.5" />
    </Style>
    <Style Selector="^.cupertino-two-item /template/ Border#Hover">
      <Setter Property="Margin" Value="-4,4.5" />
    </Style>

    <Style Selector="^:selected">
      <Setter Property="Foreground" Value="{DynamicResource CupertinoTabAccentBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="^:selected /template/ controls|GlassSurface#Lens">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="^:pointerover:not(:selected) /template/ Border#Hover">
      <Setter Property="Opacity" Value="0.4" />
    </Style>
    <Style Selector="^.cupertino-nopill /template/ controls|GlassSurface#Lens">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="^.cupertino-tabhot">
      <Setter Property="Foreground" Value="{DynamicResource CupertinoTabAccentBrush}" />
    </Style>
    <Style Selector="^.cupertino-tabcold">
      <Setter Property="Foreground" Value="{DynamicResource CupertinoLabelBrush}" />
    </Style>
    <Style Selector="^:focus-visible /template/ Border#FocusRing">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Opacity" Value="0.4" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="CupertinoTabControl" TargetType="TabControl">
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Template">
      <ControlTemplate>
        <Grid RowDefinitions="Auto,*">
          <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
          <ContentPresenter Grid.Row="1"
                            Name="PART_SelectedContentHost"
                            Margin="{TemplateBinding Padding}"
                            Content="{TemplateBinding SelectedContent}"
                            ContentTemplate="{TemplateBinding SelectedContentTemplate}" />
        </Grid>
      </ControlTemplate>
    </Setter>

    <Style Selector="^.segmented">
      <Setter Property="(controls:TabBarInteraction.IsEnabled)" Value="True" />
      <Setter Property="(controls:TabBarInteraction.IsSegmented)" Value="True" />
      <!-- Allow the indicator to grow beyond the track. -->
      <Setter Property="ClipToBounds" Value="False" />
      <Setter Property="ItemContainerTheme" Value="{StaticResource CupertinoSegmentedTabItem}" />
      <Setter Property="ItemsPanel">
        <ItemsPanelTemplate>
          <UniformGrid Rows="1" />
        </ItemsPanelTemplate>
      </Setter>
      <Setter Property="Template">
        <ControlTemplate>
          <Grid RowDefinitions="Auto,*">
            <Border Background="{DynamicResource CupertinoSegmentTrackBrush}"
                    CornerRadius="16" Height="32">
              <Panel>
                <Canvas ClipToBounds="False">
                  <Border x:Name="PART_Indicator" IsVisible="False" Background="Transparent">
                    <Border Margin="2"
                            CornerRadius="14"
                            Background="{DynamicResource CupertinoSegmentSelectedBrush}" />
                  </Border>
                </Canvas>
                <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
              </Panel>
            </Border>
            <!-- The travel lens sits above the track and labels. -->
            <Canvas ClipToBounds="False">
              <controls:GlassSurface x:Name="PART_IndicatorLens"
                                     IsVisible="False" Opacity="0"
                                     Theme="{StaticResource CupertinoSegmentTravelLens}" />
            </Canvas>
            <ContentPresenter Grid.Row="1"
                              Name="PART_SelectedContentHost"
                              Margin="{TemplateBinding Padding}"
                              Content="{TemplateBinding SelectedContent}"
                              ContentTemplate="{TemplateBinding SelectedContentTemplate}" />
          </Grid>
        </ControlTemplate>
      </Setter>
    </Style>

    <Style Selector="^.bottom">
      <Setter Property="(controls:TabBarInteraction.IsEnabled)" Value="True" />
      <!-- Allow the indicator to grow beyond the bar. -->
      <Setter Property="ClipToBounds" Value="False" />
      <Setter Property="ItemContainerTheme" Value="{StaticResource CupertinoBottomTabItem}" />
      <Setter Property="ItemsPanel">
        <ItemsPanelTemplate>
          <UniformGrid Rows="1" />
        </ItemsPanelTemplate>
      </Setter>
      <Setter Property="Template">
        <ControlTemplate>
          <Panel>
            <ContentPresenter Name="PART_SelectedContentHost"
                              Margin="{TemplateBinding Padding}"
                              Content="{TemplateBinding SelectedContent}"
                              ContentTemplate="{TemplateBinding SelectedContentTemplate}" />
            <!-- Size to the native item group. At three tabs this is
                 7 + (3 x 86) + 7 = 272pt, centred in the 402pt host. -->
            <Grid ColumnDefinitions="Auto,Auto" MaxWidth="560"
                  HorizontalAlignment="Center" VerticalAlignment="Bottom"
                  Margin="21,0,21,26">
              <controls:GlassSurface x:Name="PART_BarCapsule"
                                     Theme="{StaticResource CupertinoBottomBarSurface}">
                <Panel>
                  <ItemsPresenter Name="PART_ItemsPresenter"
                                  ClipToBounds="False"
                                  Margin="7,0"
                                  ItemsPanel="{TemplateBinding ItemsPanel}" />
                  <!-- The moving lens must render above the items. -->
                  <Canvas ClipToBounds="False">
                    <controls:GlassSurface x:Name="PART_Indicator"
                                           IsVisible="False"
                                           Theme="{StaticResource CupertinoBottomTravelLens}" />
                  </Canvas>
                </Panel>
              </controls:GlassSurface>
              <controls:GlassSurface x:Name="AccessoryHost" Grid.Column="1"
                                     Theme="{StaticResource CupertinoBottomBarSurface}"
                                     Width="62"
                                     Margin="12,0,0,0"
                                     IsVisible="False">
                <ContentPresenter Content="{TemplateBinding (controls:Tabs.Accessory)}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
              </controls:GlassSurface>
            </Grid>
          </Panel>
        </ControlTemplate>
      </Setter>
    </Style>

    <Style Selector="^.bottom.cupertino-two-item /template/ ItemsPresenter#PART_ItemsPresenter">
      <Setter Property="Margin" Value="8,0" />
    </Style>

    <Style Selector="^.bottom.has-accessory /template/ controls|GlassSurface#AccessoryHost">
      <Setter Property="IsVisible" Value="True" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="CupertinoSegmentedStripItem" TargetType="TabStripItem">
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="Foreground" Value="{DynamicResource CupertinoLabelBrush}" />
    <Setter Property="FontSize" Value="{DynamicResource CupertinoFontSize13}" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel>
          <Border x:Name="Pill"
                  CornerRadius="14"
                  Margin="2"
                  Opacity="0"
                  Background="{DynamicResource CupertinoSegmentSelectedBrush}">
            <Border.Transitions>
              <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
              </Transitions>
            </Border.Transitions>
          </Border>
          <Border x:Name="FocusRing"
                  BorderBrush="{DynamicResource CupertinoFocusRingBrush}"
                  BorderThickness="2"
                  CornerRadius="16"
                  Margin="1"
                  IsVisible="False" />
          <ContentPresenter x:Name="PART_ContentPresenter"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Padding="{TemplateBinding Padding}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
        </Panel>
      </ControlTemplate>
    </Setter>

    <Style Selector="^:selected /template/ Border#Pill">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="^.cupertino-nopill /template/ Border#Pill">
      <Setter Property="Opacity" Value="0" />
    </Style>
    <Style Selector="^:selected">
      <Setter Property="FontWeight" Value="Medium" />
    </Style>
    <Style Selector="^:pointerover:not(:selected) /template/ Border#Pill">
      <Setter Property="Opacity" Value="0.35" />
    </Style>
    <Style Selector="^:pressed">
      <Setter Property="Opacity" Value="0.6" />
    </Style>
    <Style Selector="^:focus-visible /template/ Border#FocusRing">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Opacity" Value="0.4" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="CupertinoBottomStripItem" TargetType="TabStripItem">
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="ClipToBounds" Value="False" />
    <Setter Property="Foreground" Value="{DynamicResource CupertinoLabelBrush}" />
    <Setter Property="FontSize" Value="{DynamicResource CupertinoFontSize10}" />
    <Setter Property="LetterSpacing" Value="0.25" />
    <Setter Property="Width" Value="86" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel Background="Transparent" ClipToBounds="False">
          <controls:GlassSurface x:Name="Lens"
                                 IsVisible="False"
                                 Theme="{StaticResource CupertinoBottomRestingLens}" />
          <Border x:Name="Hover"
                  CornerRadius="26.5"
                  Margin="-3,4.5"
                  Opacity="0"
                  Background="{DynamicResource CupertinoTabPillBrush}">
            <Border.Transitions>
              <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.18" />
              </Transitions>
            </Border.Transitions>
          </Border>
          <Border x:Name="FocusRing"
                  BorderBrush="{DynamicResource CupertinoFocusRingBrush}"
                  BorderThickness="2"
                  CornerRadius="16"
                  Margin="1"
                  IsVisible="False" />
          <ContentPresenter x:Name="PART_ContentPresenter"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center" />
          <controls:CupertinoBadge
              Classes="tab-badge"
              IsVisible="{Binding (controls:Tabs.BadgeValue), RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static ObjectConverters.IsNotNull}}"
              Value="{Binding (controls:Tabs.BadgeValue), RelativeSource={RelativeSource TemplatedParent}, TargetNullValue=-1}"
              HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Panel>
      </ControlTemplate>
    </Setter>

    <Style Selector="^.cupertino-two-item">
      <Setter Property="Width" Value="51" />
    </Style>
    <Style Selector="^.cupertino-two-item /template/ controls|GlassSurface#Lens">
      <Setter Property="Margin" Value="-4,4.5" />
    </Style>
    <Style Selector="^.cupertino-two-item /template/ Border#Hover">
      <Setter Property="Margin" Value="-4,4.5" />
    </Style>

    <Style Selector="^:selected">
      <Setter Property="Foreground" Value="{DynamicResource CupertinoTabAccentBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="^:selected /template/ controls|GlassSurface#Lens">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="^:pointerover:not(:selected) /template/ Border#Hover">
      <Setter Property="Opacity" Value="0.4" />
    </Style>
    <Style Selector="^.cupertino-nopill /template/ controls|GlassSurface#Lens">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="^.cupertino-tabhot">
      <Setter Property="Foreground" Value="{DynamicResource CupertinoTabAccentBrush}" />
    </Style>
    <Style Selector="^.cupertino-tabcold">
      <Setter Property="Foreground" Value="{DynamicResource CupertinoLabelBrush}" />
    </Style>
    <Style Selector="^:focus-visible /template/ Border#FocusRing">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Opacity" Value="0.4" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="CupertinoTabStrip" TargetType="TabStrip">
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="ItemContainerTheme" Value="{StaticResource CupertinoSegmentedStripItem}" />
    <Setter Property="ItemsPanel">
      <ItemsPanelTemplate>
        <UniformGrid Rows="1" />
      </ItemsPanelTemplate>
    </Setter>
    <Setter Property="Template">
      <ControlTemplate>
        <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
      </ControlTemplate>
    </Setter>

    <Style Selector="^.segmented">
      <Setter Property="(controls:TabBarInteraction.IsEnabled)" Value="True" />
      <Setter Property="(controls:TabBarInteraction.IsSegmented)" Value="True" />
      <!-- Allow the indicator to grow beyond the track. -->
      <Setter Property="ClipToBounds" Value="False" />
      <Setter Property="Template">
        <ControlTemplate>
          <Panel>
            <Border Background="{DynamicResource CupertinoSegmentTrackBrush}"
                    CornerRadius="16" Height="32">
              <Panel>
                <Canvas ClipToBounds="False">
                  <Border x:Name="PART_Indicator" IsVisible="False" Background="Transparent">
                    <Border Margin="2"
                            CornerRadius="14"
                            Background="{DynamicResource CupertinoSegmentSelectedBrush}" />
                  </Border>
                </Canvas>
                <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
              </Panel>
            </Border>
            <Canvas ClipToBounds="False">
              <controls:GlassSurface x:Name="PART_IndicatorLens"
                                     IsVisible="False" Opacity="0"
                                     Theme="{StaticResource CupertinoSegmentTravelLens}" />
            </Canvas>
          </Panel>
        </ControlTemplate>
      </Setter>
    </Style>

    <Style Selector="^.bottom">
      <Setter Property="(controls:TabBarInteraction.IsEnabled)" Value="True" />
      <!-- Allow the indicator to grow beyond the bar. -->
      <Setter Property="ClipToBounds" Value="False" />
      <Setter Property="ItemContainerTheme" Value="{StaticResource CupertinoBottomStripItem}" />
      <Setter Property="Template">
        <ControlTemplate>
          <Grid ColumnDefinitions="Auto,Auto" MaxWidth="560"
                HorizontalAlignment="Center" Margin="21,0">
            <controls:GlassSurface x:Name="PART_BarCapsule"
                                   Theme="{StaticResource CupertinoBottomBarSurface}">
              <Panel>
                <ItemsPresenter Name="PART_ItemsPresenter"
                                ClipToBounds="False"
                                Margin="7,0"
                                ItemsPanel="{TemplateBinding ItemsPanel}" />
                <Canvas ClipToBounds="False">
                  <controls:GlassSurface x:Name="PART_Indicator"
                                         IsVisible="False"
                                         Theme="{StaticResource CupertinoBottomTravelLens}" />
                </Canvas>
              </Panel>
            </controls:GlassSurface>
            <controls:GlassSurface x:Name="AccessoryHost" Grid.Column="1"
                                   Theme="{StaticResource CupertinoBottomBarSurface}"
                                   Width="62"
                                   Margin="12,0,0,0"
                                   IsVisible="False">
              <ContentPresenter Content="{TemplateBinding (controls:Tabs.Accessory)}"
                                HorizontalAlignment="Center" VerticalAlignment="Center" />
            </controls:GlassSurface>
          </Grid>
        </ControlTemplate>
      </Setter>
    </Style>

    <Style Selector="^.bottom.cupertino-two-item /template/ ItemsPresenter#PART_ItemsPresenter">
      <Setter Property="Margin" Value="8,0" />
    </Style>

    <Style Selector="^.bottom.has-accessory /template/ controls|GlassSurface#AccessoryHost">
      <Setter Property="IsVisible" Value="True" />
    </Style>

  </ControlTheme>

  <ControlTheme x:Key="{x:Type TabStrip}"
                TargetType="TabStrip"
                BasedOn="{StaticResource CupertinoTabStrip}" />

  <ControlTheme x:Key="{x:Type TabStripItem}"
                TargetType="TabStripItem"
                BasedOn="{StaticResource CupertinoSegmentedStripItem}" />

  <ControlTheme x:Key="{x:Type TabControl}"
                TargetType="TabControl"
                BasedOn="{StaticResource CupertinoTabControl}" />

  <ControlTheme x:Key="{x:Type TabItem}"
                TargetType="TabItem"
                BasedOn="{StaticResource CupertinoSegmentedTabItem}" />

</ResourceDictionary>
