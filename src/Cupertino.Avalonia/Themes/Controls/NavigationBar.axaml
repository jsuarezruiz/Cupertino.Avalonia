<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="using:Cupertino.Controls">

  <ControlTheme x:Key="CupertinoBarButton" TargetType="Button">
    <Setter Property="Foreground" Value="{DynamicResource CupertinoLabelBrush}" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="MinWidth" Value="44" />
    <Setter Property="Height" Value="36" />
    <Setter Property="ClipToBounds" Value="False" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel ClipToBounds="False">
          <!-- The outer border prevents the material shadow from clipping. -->
          <Border CornerRadius="18" Background="Transparent"
                  BoxShadow="0 2 12 0 #1A000000">
            <c:GlassSurface CornerRadius="18"
                            BlurRadius="18" GlassThickness="0" Saturation="1"
                            RefractionStrength="0" ChromaticAberration="0"
                            DepthEffect="0" LightIntensity="0"
                            FresnelStrength="0" Magnification="1"
                            Tint="{DynamicResource CupertinoBarButtonTint}"
                            ShadowOpacity="0">
              <ContentPresenter Name="PART_ContentPresenter"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                Padding="{TemplateBinding Padding}"
                                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
            </c:GlassSurface>
          </Border>
        </Panel>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pressed">
      <Setter Property="RenderTransform" Value="scale(0.96)" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type c:CupertinoNavigationBar}" TargetType="c:CupertinoNavigationBar">
    <Setter Property="ClipToBounds" Value="False" />
    <Setter Property="Height" Value="113" />
    <Setter Property="VerticalAlignment" Value="Top" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel>
          <c:GlassSurface x:Name="PART_Backdrop"
                          Height="110" VerticalAlignment="Top"
                          CornerRadius="0"
                          BlurRadius="7" Saturation="1.15"
                          GlassThickness="0.1" RefractionStrength="0"
                          ChromaticAberration="0" DepthEffect="0"
                          ShadowOpacity="0"
                          IsAdaptive="True"
                          Tint="{DynamicResource CupertinoNavigationBarTint}"
                          Opacity="{TemplateBinding BackdropOpacity}">
            <c:GlassSurface.OpacityMask>
              <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                <GradientStop Offset="0.0" Color="#FFFFFFFF" />
                <GradientStop Offset="0.78" Color="#FFFFFFFF" />
                <GradientStop Offset="1.0" Color="#00FFFFFF" />
              </LinearGradientBrush>
            </c:GlassSurface.OpacityMask>
          </c:GlassSurface>

          <!-- Span all columns so asymmetric buttons do not shift the title. -->
          <Grid x:Name="PART_ToolbarRow"
                ColumnDefinitions="Auto,*,Auto" Height="34" Margin="16,22,16,0"
                VerticalAlignment="Top">
            <TextBlock x:Name="PART_InlineTitle"
                       Grid.Column="0" Grid.ColumnSpan="3"
                       Text="{TemplateBinding Title}"
                       FontSize="{DynamicResource CupertinoFontSize17}" FontWeight="SemiBold"
                       LetterSpacing="0.9"
                       Margin="72,0"
                       Padding="0,0,1,0"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       Foreground="{DynamicResource CupertinoLabelBrush}"
                       Opacity="{TemplateBinding InlineTitleOpacity}" />

            <ContentPresenter x:Name="PART_Leading" Grid.Column="0"
                              Content="{TemplateBinding LeadingContent}"
                              VerticalAlignment="Center" />
            <ContentPresenter x:Name="PART_Trailing" Grid.Column="2"
                              Content="{TemplateBinding TrailingContent}"
                              VerticalAlignment="Center" />
          </Grid>

          <TextBlock x:Name="PART_LargeTitle"
                     Text="{TemplateBinding Title}"
                     FontSize="{DynamicResource CupertinoFontSize34}" FontWeight="Bold"
                     Margin="17,64,16,0"
                     Padding="0,0,2,0"
                     VerticalAlignment="Top"
                     TextTrimming="CharacterEllipsis"
                     Foreground="{DynamicResource CupertinoLabelBrush}"
                     Opacity="{TemplateBinding LargeTitleOpacity}">
            <TextBlock.RenderTransform>
              <TranslateTransform Y="{Binding LargeTitleOffset, RelativeSource={RelativeSource TemplatedParent}}" />
            </TextBlock.RenderTransform>
          </TextBlock>
        </Panel>
      </ControlTemplate>
    </Setter>

    <!-- Inline bars do not reserve large-title space. -->
    <Style Selector="^[IsLargeTitle=False]">
      <Setter Property="Height" Value="61" />
    </Style>

    <!-- Embedded bars do not own the status-bar inset. -->
    <Style Selector="^.embedded">
      <Setter Property="Height" Value="44" />
    </Style>
    <Style Selector="^.embedded /template/ Grid#PART_ToolbarRow">
      <Setter Property="Margin" Value="16,5,16,0" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type c:CupertinoNavigationPage}" TargetType="c:CupertinoNavigationPage">
    <Setter Property="Template">
      <ControlTemplate>
        <Panel>
          <Panel x:Name="PART_Host" ClipToBounds="True" />
          <c:CupertinoNavigationBar x:Name="PART_Bar" VerticalAlignment="Top" />
        </Panel>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

</ResourceDictionary>
