<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:motion="clr-namespace:Cupertino.Animation"
                    xmlns:controls="clr-namespace:Cupertino.Controls">

  <ControlTheme x:Key="CupertinoRepeatButton" TargetType="RepeatButton">
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="Foreground" Value="{DynamicResource CupertinoLabelBrush}" />
    <Setter Property="FontSize" Value="{DynamicResource CupertinoFontSize17}" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Padding" Value="14,7" />
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="ClipToBounds" Value="False" />
    <Setter Property="Delay" Value="500" />
    <Setter Property="Interval" Value="80" />
    <Setter Property="RenderTransform" Value="scale(1.0)" />
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="{motion:MotionDuration 130}" Easing="SineEaseOut" />
        <DoubleTransition Property="Opacity" Duration="{motion:MotionDuration 100}" />
      </Transitions>
    </Setter>

    <Setter Property="Template">
      <ControlTemplate>
        <Panel ClipToBounds="False">
          <controls:GlassSurface x:Name="GlassBg"
                                 Theme="{StaticResource CupertinoGlassButtonSurface}" />
          <ContentPresenter x:Name="PART_ContentPresenter"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Padding="{TemplateBinding Padding}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                            Background="Transparent" />
          <Border x:Name="FocusRing"
                  CornerRadius="999"
                  Margin="-4"
                  BorderBrush="{DynamicResource CupertinoFocusRingBrush}"
                  BorderThickness="2"
                  Opacity="0">
            <Border.Transitions>
              <Transitions>
                <DoubleTransition Property="Opacity" Duration="{motion:MotionDuration 100}" />
              </Transitions>
            </Border.Transitions>
          </Border>
        </Panel>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover /template/ controls|GlassSurface#GlassBg">
      <Setter Property="LightIntensity" Value="1.0" />
    </Style>
    <Style Selector="^:pressed">
      <Setter Property="RenderTransform" Value="scale(1.04)" />
    </Style>
    <Style Selector="^:pressed /template/ controls|GlassSurface#GlassBg">
      <Setter Property="LightIntensity" Value="1.4" />
    </Style>
    <Style Selector="^:focus-visible /template/ Border#FocusRing">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Opacity" Value="0.4" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="CupertinoToggleButton" TargetType="ToggleButton">
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="Foreground" Value="{DynamicResource CupertinoLabelBrush}" />
    <Setter Property="FontSize" Value="{DynamicResource CupertinoFontSize17}" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Padding" Value="14,7" />
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="ClipToBounds" Value="False" />
    <Setter Property="RenderTransform" Value="scale(1.0)" />
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="{motion:MotionDuration 130}" Easing="SineEaseOut" />
        <DoubleTransition Property="Opacity" Duration="{motion:MotionDuration 100}" />
      </Transitions>
    </Setter>
    <Setter Property="Template">
      <ControlTemplate>
        <Panel ClipToBounds="False">
          <controls:GlassSurface x:Name="GlassBg"
                                 Theme="{StaticResource CupertinoGlassButtonSurface}" />
          <ContentPresenter x:Name="PART_ContentPresenter"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Padding="{TemplateBinding Padding}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                            Background="Transparent" />
          <Border x:Name="FocusRing"
                  CornerRadius="999" Margin="-4"
                  BorderBrush="{DynamicResource CupertinoFocusRingBrush}"
                  BorderThickness="2" Opacity="0" />
        </Panel>
      </ControlTemplate>
    </Setter>

    <Style Selector="^:checked /template/ controls|GlassSurface#GlassBg">
      <Setter Property="IsAdaptive" Value="False" />
      <Setter Property="Tint" Value="{DynamicResource CupertinoProminentTint}" />
      <Setter Property="Saturation" Value="1.0" />
      <Setter Property="ChromaticAberration" Value="0.05" />
      <Setter Property="LightIntensity" Value="0.5" />
    </Style>
    <Style Selector="^:checked">
      <Setter Property="Foreground" Value="{DynamicResource CupertinoProminentForegroundBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="^:indeterminate /template/ controls|GlassSurface#GlassBg">
      <Setter Property="Tint" Value="{DynamicResource CupertinoGlassButtonTint}" />
    </Style>
    <Style Selector="^:indeterminate">
      <Setter Property="Opacity" Value="0.6" />
    </Style>

    <Style Selector="^:pointerover /template/ controls|GlassSurface#GlassBg">
      <Setter Property="LightIntensity" Value="1.0" />
    </Style>
    <Style Selector="^:pressed">
      <Setter Property="RenderTransform" Value="scale(1.04)" />
    </Style>
    <Style Selector="^:pressed /template/ controls|GlassSurface#GlassBg">
      <Setter Property="LightIntensity" Value="1.4" />
    </Style>
    <Style Selector="^:focus-visible /template/ Border#FocusRing">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Opacity" Value="0.4" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="CupertinoHyperlinkButton" TargetType="HyperlinkButton">
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="Foreground" Value="{DynamicResource CupertinoAccentBrush}" />
    <Setter Property="FontSize" Value="{DynamicResource CupertinoFontSize17}" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="{motion:MotionDuration 120}" />
      </Transitions>
    </Setter>
    <Setter Property="Template">
      <ControlTemplate>
        <Panel Background="Transparent">
          <ContentPresenter Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Padding="{TemplateBinding Padding}"
                            Background="Transparent"
                            VerticalContentAlignment="Center" />
          <Border x:Name="FocusRing"
                  CornerRadius="6" Margin="-5,-3"
                  BorderBrush="{DynamicResource CupertinoFocusRingBrush}"
                  BorderThickness="2" Opacity="0" />
        </Panel>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover">
      <Setter Property="Opacity" Value="0.7" />
    </Style>
    <Style Selector="^:pressed">
      <Setter Property="Opacity" Value="0.4" />
    </Style>
    <Style Selector="^:focus-visible /template/ Border#FocusRing">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Opacity" Value="0.4" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="CupertinoDropDownButton" TargetType="DropDownButton"
                BasedOn="{StaticResource CupertinoButton}">
    <Setter Property="Template">
      <ControlTemplate>
        <Panel ClipToBounds="False">
          <controls:GlassSurface x:Name="GlassBg"
                                 Theme="{StaticResource CupertinoGlassButtonSurface}" />
          <!-- Names are required by inherited selectors. -->
          <Border x:Name="FlatBg"
                  CornerRadius="999"
                  IsVisible="False"
                  Background="{DynamicResource CupertinoBorderedFillBrush}" />
          <StackPanel Orientation="Horizontal" Spacing="6"
                      Margin="{TemplateBinding Padding}"
                      HorizontalAlignment="Center" VerticalAlignment="Center">
            <ContentPresenter Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              VerticalContentAlignment="Center" />
            <Path Data="{StaticResource CupertinoChevronDownGeometry}"
                  Stroke="{TemplateBinding Foreground}"
                  StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round"
                  Width="16" Height="16" Stretch="None"
                  VerticalAlignment="Center" />
          </StackPanel>
          <Border x:Name="FocusRing"
                  CornerRadius="999"
                  Margin="-4"
                  BorderBrush="{DynamicResource CupertinoFocusRingBrush}"
                  BorderThickness="2"
                  Opacity="0">
            <Border.Transitions>
              <Transitions>
                <DoubleTransition Property="Opacity" Duration="{motion:MotionDuration 100}" />
              </Transitions>
            </Border.Transitions>
          </Border>
        </Panel>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <ControlTheme x:Key="CupertinoSplitButtonSection" TargetType="Button">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource CupertinoLabelBrush}" />
    <Setter Property="FontSize" Value="{DynamicResource CupertinoFontSize17}" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel Background="Transparent">
          <Border x:Name="Fill" Background="Transparent">
            <Border.Transitions>
              <Transitions>
                <BrushTransition Property="Background" Duration="{motion:MotionDuration 180}" />
              </Transitions>
            </Border.Transitions>
          </Border>
          <ContentPresenter Content="{TemplateBinding Content}"
                            Padding="{TemplateBinding Padding}"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center" />
          <Border x:Name="FocusRing"
                  CornerRadius="10" Margin="2"
                  BorderBrush="{DynamicResource CupertinoFocusRingBrush}"
                  BorderThickness="2" Opacity="0" />
        </Panel>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover /template/ Border#Fill">
      <Setter Property="Background" Value="{DynamicResource CupertinoMenuRowPointerOverBrush}" />
    </Style>
    <Style Selector="^:pressed /template/ Border#Fill">
      <Setter Property="Background" Value="{DynamicResource CupertinoMenuRowPressedBrush}" />
    </Style>
    <Style Selector="^:focus-visible /template/ Border#FocusRing">
      <Setter Property="Opacity" Value="1" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="CupertinoSplitButton" TargetType="SplitButton">
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="Foreground" Value="{DynamicResource CupertinoLabelBrush}" />
    <Setter Property="FontSize" Value="{DynamicResource CupertinoFontSize17}" />
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="Padding" Value="14,7" />
    <Setter Property="ClipToBounds" Value="False" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel ClipToBounds="False">
          <controls:GlassSurface x:Name="GlassBg"
                                 Theme="{StaticResource CupertinoGlassButtonSurface}" />
          <Border CornerRadius="999" ClipToBounds="True">
            <Grid ColumnDefinitions="*,0.5,Auto">
              <Button x:Name="PART_PrimaryButton" Grid.Column="0"
                      Theme="{StaticResource CupertinoSplitButtonSection}"
                      Content="{TemplateBinding Content}"
                      ContentTemplate="{TemplateBinding ContentTemplate}"
                      Padding="{TemplateBinding Padding}" />
              <Rectangle Grid.Column="1" Margin="0,7"
                         Fill="{DynamicResource CupertinoSeparatorBrush}" />
              <Button x:Name="PART_SecondaryButton" Grid.Column="2"
                      Theme="{StaticResource CupertinoSplitButtonSection}"
                      Padding="10,7">
                <Path Data="{StaticResource CupertinoChevronDownGeometry}"
                      Stroke="{DynamicResource CupertinoLabelBrush}"
                      StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round"
                      Width="16" Height="16" Stretch="None" />
              </Button>
            </Grid>
          </Border>
          <Border x:Name="FocusRing" IsHitTestVisible="False"
                  CornerRadius="999" Margin="-4"
                  BorderBrush="{DynamicResource CupertinoFocusRingBrush}"
                  BorderThickness="2" IsVisible="False" />
        </Panel>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:focus-visible /template/ Border#FocusRing">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Opacity" Value="0.4" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="CupertinoToggleSplitButton" TargetType="ToggleSplitButton"
                BasedOn="{StaticResource CupertinoSplitButton}">
    <Style Selector="^:checked">
      <Setter Property="Foreground" Value="{DynamicResource CupertinoProminentForegroundBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="^:checked /template/ controls|GlassSurface#GlassBg">
      <Setter Property="IsAdaptive" Value="False" />
      <Setter Property="Tint" Value="{DynamicResource CupertinoProminentTint}" />
      <Setter Property="Saturation" Value="1.0" />
      <Setter Property="ChromaticAberration" Value="0.05" />
      <Setter Property="LightIntensity" Value="0.5" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type RepeatButton}" TargetType="RepeatButton"
                BasedOn="{StaticResource CupertinoRepeatButton}" />
  <ControlTheme x:Key="{x:Type ToggleButton}" TargetType="ToggleButton"
                BasedOn="{StaticResource CupertinoToggleButton}" />
  <ControlTheme x:Key="{x:Type HyperlinkButton}" TargetType="HyperlinkButton"
                BasedOn="{StaticResource CupertinoHyperlinkButton}" />
  <ControlTheme x:Key="{x:Type DropDownButton}" TargetType="DropDownButton"
                BasedOn="{StaticResource CupertinoDropDownButton}" />
  <ControlTheme x:Key="{x:Type SplitButton}" TargetType="SplitButton"
                BasedOn="{StaticResource CupertinoSplitButton}" />
  <ControlTheme x:Key="{x:Type ToggleSplitButton}" TargetType="ToggleSplitButton"
                BasedOn="{StaticResource CupertinoToggleSplitButton}" />

</ResourceDictionary>
