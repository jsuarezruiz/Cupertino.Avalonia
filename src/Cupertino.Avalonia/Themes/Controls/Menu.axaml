<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:motion="clr-namespace:Cupertino.Animation"
                    xmlns:controls="clr-namespace:Cupertino.Controls">

  <ControlTheme x:Key="CupertinoTopLevelMenuItem" TargetType="MenuItem">
    <Setter Property="Foreground" Value="{DynamicResource CupertinoLabelBrush}" />
    <Setter Property="FontSize" Value="{DynamicResource CupertinoFontSize14}" />
    <Setter Property="Padding" Value="10,4" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel>
          <Border x:Name="Chrome" CornerRadius="6" Background="Transparent" />
          <ContentPresenter Content="{TemplateBinding Header}"
                            Margin="{TemplateBinding Padding}"
                            VerticalAlignment="Center" />
          <Popup x:Name="PART_Popup"
                 ShouldUseOverlayLayer="True"
                 controls:CupertinoFlyoutTransition.IsEnabled="True"
                 controls:CupertinoFlyoutTransition.IsOpen="{TemplateBinding IsSubMenuOpen, Mode=TwoWay}"
                 IsLightDismissEnabled="False"
                 Placement="BottomEdgeAlignedLeft">
            <Panel Classes="cupertino-popover source-transition" Margin="18,6,18,18">
              <Grid MinWidth="180">
                <controls:GlassSurface Classes="source-transition-material" CornerRadius="12"
                                       BlurRadius="28" Saturation="1.8"
                                       GlassThickness="0.35" RefractionStrength="0.10"
                                       ChromaticAberration="0" DepthEffect="0.25"
                                       IsAdaptive="True"
                                       ShadowOpacity="0.14" ShadowBlur="18" ShadowOffset="6" />
                <Border Classes="source-transition-content" CornerRadius="12" ClipToBounds="True">
                  <ItemsPresenter Name="PART_ItemsPresenter"
                                  ItemsPanel="{TemplateBinding ItemsPanel}"
                                  Margin="0,6" />
                </Border>
              </Grid>
            </Panel>
          </Popup>
        </Panel>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover /template/ Border#Chrome">
      <Setter Property="Background" Value="{DynamicResource CupertinoMenuRowHoverBrush}" />
    </Style>
    <Style Selector="^:open /template/ Border#Chrome">
      <Setter Property="Background" Value="{DynamicResource CupertinoMenuRowPressedBrush}" />
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Opacity" Value="0.4" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type Menu}" TargetType="Menu">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}">
          <ItemsPresenter Name="PART_ItemsPresenter"
                          ItemsPanel="{TemplateBinding ItemsPanel}" />
        </Border>
      </ControlTemplate>
    </Setter>
    <!-- ControlTheme does not allow descendant selectors. -->
    <Setter Property="ItemContainerTheme" Value="{StaticResource CupertinoTopLevelMenuItem}" />
  </ControlTheme>

</ResourceDictionary>

