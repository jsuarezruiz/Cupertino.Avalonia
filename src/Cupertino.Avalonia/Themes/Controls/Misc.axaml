<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:Cupertino.Controls"
                    xmlns:notifications="clr-namespace:Avalonia.Controls.Notifications;assembly=Avalonia.Controls">

  <ControlTheme x:Key="{x:Type ToolTip}" TargetType="ToolTip">
    <Style Selector="^">
      <Style.Animations>
        <Animation Duration="0:0:0.12" Easing="QuadraticEaseOut">
          <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0" /></KeyFrame>
          <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1" /></KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <Setter Property="Background" Value="{DynamicResource CupertinoMenuPanelBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource CupertinoLabelBrush}" />
    <Setter Property="FontSize" Value="{DynamicResource CupertinoFontSize13}" />
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="MaxWidth" Value="320" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}"
                CornerRadius="{TemplateBinding CornerRadius}"
                Padding="{TemplateBinding Padding}"
                BoxShadow="0 4 14 0 #26000000">
          <ContentPresenter Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            TextBlock.TextWrapping="Wrap" />
        </Border>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <ControlTheme x:Key="CupertinoTopLevelMenuItem" TargetType="MenuItem">
    <Setter Property="Foreground" Value="{DynamicResource CupertinoLabelBrush}" />
    <Setter Property="FontSize" Value="{DynamicResource CupertinoFontSize14}" />
    <Setter Property="Padding" Value="10,4" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel>
          <Border x:Name="Chrome" CornerRadius="6" Background="Transparent" />
          <ContentPresenter Content="{TemplateBinding Header}"
                            Margin="{TemplateBinding Padding}"
                            VerticalAlignment="Center" />
          <Popup x:Name="PART_Popup"
                 IsOpen="{TemplateBinding IsSubMenuOpen, Mode=TwoWay}"
                 IsLightDismissEnabled="True"
                 ShouldUseOverlayLayer="True"
                 Placement="BottomEdgeAlignedLeft">
            <Panel Classes="cupertino-popover" Margin="18,6,18,18">
              <controls:GlassSurface CornerRadius="12"
                                     BlurRadius="28" Saturation="1.8"
                                     GlassThickness="0.35" RefractionStrength="0.10"
                                     ChromaticAberration="0" DepthEffect="0.25"
                                     IsAdaptive="True"
                                     ShadowOpacity="0.20" ShadowBlur="30" ShadowOffset="10"
                                     MinWidth="180">
                <Border CornerRadius="12" ClipToBounds="True">
                  <ItemsPresenter Name="PART_ItemsPresenter"
                                  ItemsPanel="{TemplateBinding ItemsPanel}"
                                  Margin="0,6" />
                </Border>
              </controls:GlassSurface>
            </Panel>
          </Popup>
        </Panel>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover /template/ Border#Chrome">
      <Setter Property="Background" Value="{DynamicResource CupertinoMenuRowHoverBrush}" />
    </Style>
    <Style Selector="^:open /template/ Border#Chrome">
      <Setter Property="Background" Value="{DynamicResource CupertinoMenuRowPressedBrush}" />
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Opacity" Value="0.4" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type Menu}" TargetType="Menu">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}">
          <ItemsPresenter Name="PART_ItemsPresenter"
                          ItemsPanel="{TemplateBinding ItemsPanel}" />
        </Border>
      </ControlTemplate>
    </Setter>
    <!-- ControlTheme does not allow descendant selectors. -->
    <Setter Property="ItemContainerTheme" Value="{StaticResource CupertinoTopLevelMenuItem}" />
  </ControlTheme>

  <ControlTheme x:Key="{x:Type TreeViewItem}" TargetType="TreeViewItem">
    <Setter Property="Foreground" Value="{DynamicResource CupertinoLabelBrush}" />
    <Setter Property="FontSize" Value="{DynamicResource CupertinoFontSize17}" />
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="Template">
      <ControlTemplate>
        <StackPanel>
          <Border x:Name="PART_Header" MinHeight="44" Background="Transparent">
            <Border.Transitions>
              <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.18" />
              </Transitions>
            </Border.Transitions>
            <Grid ColumnDefinitions="Auto,*" Margin="{TemplateBinding Padding}">
              <ToggleButton x:Name="PART_ExpandCollapseChevron"
                            Theme="{StaticResource CupertinoTreeChevron}"
                            IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" />
              <ContentPresenter Grid.Column="1"
                                Name="PART_HeaderPresenter"
                                Content="{TemplateBinding Header}"
                                ContentTemplate="{TemplateBinding HeaderTemplate}"
                                VerticalAlignment="Center" />
            </Grid>
          </Border>
          <ItemsPresenter Name="PART_ItemsPresenter"
                          IsVisible="{TemplateBinding IsExpanded}"
                          ItemsPanel="{TemplateBinding ItemsPanel}" />
        </StackPanel>
      </ControlTemplate>
    </Setter>

    <Style Selector="^:pointerover /template/ Border#PART_Header">
      <Setter Property="Background" Value="{DynamicResource CupertinoRowHoverBrush}" />
    </Style>
    <Style Selector="^:selected /template/ Border#PART_Header">
      <Setter Property="Background" Value="{DynamicResource CupertinoAccentSubtleBrush}" />
    </Style>
    <Style Selector="^:expanded /template/ ItemsPresenter#PART_ItemsPresenter">
      <Style.Animations>
        <Animation Duration="0:0:0.2" Easing="QuadraticEaseOut">
          <KeyFrame Cue="0%">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="TranslateTransform.Y" Value="-6" />
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="TranslateTransform.Y" Value="0" />
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <Style Selector="^:empty /template/ ToggleButton#PART_ExpandCollapseChevron">
      <Setter Property="Opacity" Value="0" />
      <Setter Property="IsHitTestVisible" Value="False" />
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Opacity" Value="0.4" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="CupertinoTreeChevron" TargetType="ToggleButton">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Width" Value="24" />
    <Setter Property="Height" Value="24" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel Background="Transparent">
          <Path x:Name="Glyph"
                Data="{StaticResource CupertinoChevronRightGeometry}"
                Stroke="{DynamicResource CupertinoTertiaryLabelBrush}"
                StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round"
                Width="16" Height="16" Stretch="None"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                RenderTransformOrigin="50%,50%">
            <Path.Transitions>
              <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2" />
              </Transitions>
            </Path.Transitions>
          </Path>
        </Panel>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:checked /template/ Path#Glyph">
      <Setter Property="RenderTransform" Value="rotate(90deg)" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type TreeView}" TargetType="TreeView">
    <Setter Property="Background" Value="{DynamicResource CupertinoCardBrush}" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}"
                CornerRadius="{TemplateBinding CornerRadius}"
                ClipToBounds="True">
          <ScrollViewer>
            <ItemsPresenter Name="PART_ItemsPresenter"
                            ItemsPanel="{TemplateBinding ItemsPanel}" />
          </ScrollViewer>
        </Border>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type Label}" TargetType="Label">
    <Setter Property="Foreground" Value="{DynamicResource CupertinoLabelBrush}" />
    <Setter Property="FontSize" Value="{DynamicResource CupertinoFontSize17}" />
    <Setter Property="Padding" Value="0,2" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <ControlTemplate>
        <ContentPresenter Content="{TemplateBinding Content}"
                          ContentTemplate="{TemplateBinding ContentTemplate}"
                          RecognizesAccessKey="True"
                          Padding="{TemplateBinding Padding}"
                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
      </ControlTemplate>
    </Setter>
    <Style Selector="^:disabled">
      <Setter Property="Opacity" Value="0.4" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type MaskedTextBox}" TargetType="MaskedTextBox"
                BasedOn="{StaticResource CupertinoTextBox}" />

  <ControlTheme x:Key="{x:Type ContextMenu}" TargetType="ContextMenu">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel Classes="cupertino-popover" Margin="18,10,18,18">
          <controls:GlassSurface CornerRadius="14"
                                 BlurRadius="28" Saturation="1.8"
                                 GlassThickness="0.35" RefractionStrength="0.10"
                                 ChromaticAberration="0" DepthEffect="0.25"
                                 IsAdaptive="True"
                                 ShadowOpacity="0.20" ShadowBlur="30" ShadowOffset="10"
                                 MinWidth="220">
            <Border CornerRadius="14" ClipToBounds="True">
              <ItemsPresenter Name="PART_ItemsPresenter"
                              ItemsPanel="{TemplateBinding ItemsPanel}"
                              Margin="0,6" />
            </Border>
          </controls:GlassSurface>
        </Panel>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type FlyoutPresenter}" TargetType="FlyoutPresenter">
    <Setter Property="Foreground" Value="{DynamicResource CupertinoLabelBrush}" />
    <Setter Property="Padding" Value="16" />
    <Setter Property="MaxWidth" Value="456" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel Classes="cupertino-popover" Margin="18,10,18,18">
          <controls:GlassSurface CornerRadius="14"
                                 BlurRadius="28" Saturation="1.8"
                                 GlassThickness="0.35" RefractionStrength="0.10"
                                 ChromaticAberration="0" DepthEffect="0.25"
                                 IsAdaptive="True"
                                 ShadowOpacity="0.20" ShadowBlur="30" ShadowOffset="10">
            <Border CornerRadius="14" ClipToBounds="True">
              <ScrollViewer HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                            VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}">
                <ContentPresenter Content="{TemplateBinding Content}"
                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                  Padding="{TemplateBinding Padding}" />
              </ScrollViewer>
            </Border>
          </controls:GlassSurface>
        </Panel>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type notifications:NotificationCard}"
                TargetType="notifications:NotificationCard">
    <Setter Property="Width" Value="350" />
    <!-- Preserve DataType matching when custom controls are shown. -->
    <Setter Property="ContentTemplate">
      <DataTemplate>
        <ContentControl Content="{Binding}">
          <ContentControl.DataTemplates>
            <DataTemplate DataType="notifications:INotification">
              <StackPanel Spacing="2">
                <TextBlock Text="{Binding Title}" FontSize="{DynamicResource CupertinoFontSize15}" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Message}" FontSize="{DynamicResource CupertinoFontSize13}"
                           Foreground="{DynamicResource CupertinoSecondaryLabelBrush}"
                           TextWrapping="Wrap" />
              </StackPanel>
            </DataTemplate>
          </ContentControl.DataTemplates>
        </ContentControl>
      </DataTemplate>
    </Setter>
    <Setter Property="Template">
      <ControlTemplate>
        <!-- Avoid recursive backdrop sampling in the adorner layer. -->
        <Panel Margin="8,4,8,12">
          <Border CornerRadius="18"
                  Background="{DynamicResource CupertinoMenuPanelBrush}"
                  ClipToBounds="True"
                  BoxShadow="0 10 30 0 #33000000, 0 2 6 0 #1F000000">
            <Grid ColumnDefinitions="Auto,*,Auto" Margin="16,12">
              <Ellipse x:Name="TypeDot" Width="8" Height="8"
                       Margin="0,6,10,0" VerticalAlignment="Top"
                       Fill="{DynamicResource CupertinoAccentBrush}" />
              <ContentPresenter Grid.Column="1"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}" />
              <Button x:Name="Close" Grid.Column="2"
                      Classes="plain" MinHeight="0" Padding="4"
                      Margin="8,0,0,0" VerticalAlignment="Top"
                      IsVisible="False"
                      notifications:NotificationCard.CloseOnClick="True">
                <Path Data="{StaticResource CupertinoXMarkGeometry}"
                      Stroke="{DynamicResource CupertinoSecondaryLabelBrush}"
                      StrokeThickness="2" StrokeLineCap="Round"
                      Width="10" Height="10" Stretch="Uniform" />
              </Button>
            </Grid>
          </Border>
        </Panel>
      </ControlTemplate>
    </Setter>

    <Style Selector="^">
      <Style.Animations>
        <Animation Duration="0:0:0.25" Easing="QuadraticEaseOut">
          <KeyFrame Cue="0%">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="TranslateTransform.Y" Value="-16" />
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="TranslateTransform.Y" Value="0" />
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>

    <Style Selector="^[IsClosing=true]">
      <Style.Animations>
        <Animation Duration="0:0:0.12" Easing="QuadraticEaseIn" FillMode="Forward">
          <KeyFrame Cue="0%">
            <Setter Property="Opacity" Value="1" />
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="Opacity" Value="0" />
          </KeyFrame>
        </Animation>
        <Animation Duration="0:0:0.14" FillMode="Forward">
          <KeyFrame Cue="100%">
            <Setter Property="IsClosed" Value="True" />
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>

    <Style Selector="^:pointerover /template/ Button#Close">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="^[NotificationType=Success] /template/ Ellipse#TypeDot">
      <Setter Property="Fill" Value="{DynamicResource CupertinoSuccessBrush}" />
    </Style>
    <Style Selector="^[NotificationType=Warning] /template/ Ellipse#TypeDot">
      <Setter Property="Fill" Value="{DynamicResource CupertinoWarningBrush}" />
    </Style>
    <Style Selector="^[NotificationType=Error] /template/ Ellipse#TypeDot">
      <Setter Property="Fill" Value="{DynamicResource CupertinoDangerBrush}" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type notifications:WindowNotificationManager}"
                TargetType="notifications:WindowNotificationManager">
    <Setter Property="Margin" Value="0,8" />
    <Setter Property="Template">
      <ControlTemplate>
        <ReversibleStackPanel Name="PART_Items" />
      </ControlTemplate>
    </Setter>
    <Style Selector="^:topleft /template/ ReversibleStackPanel#PART_Items">
      <Setter Property="VerticalAlignment" Value="Top" />
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style Selector="^:topright /template/ ReversibleStackPanel#PART_Items">
      <Setter Property="VerticalAlignment" Value="Top" />
      <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>
    <Style Selector="^:topcenter /template/ ReversibleStackPanel#PART_Items">
      <Setter Property="VerticalAlignment" Value="Top" />
      <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
    <Style Selector="^:bottomleft /template/ ReversibleStackPanel#PART_Items">
      <Setter Property="ReverseOrder" Value="True" />
      <Setter Property="VerticalAlignment" Value="Bottom" />
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style Selector="^:bottomright /template/ ReversibleStackPanel#PART_Items">
      <Setter Property="ReverseOrder" Value="True" />
      <Setter Property="VerticalAlignment" Value="Bottom" />
      <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>
    <Style Selector="^:bottomcenter /template/ ReversibleStackPanel#PART_Items">
      <Setter Property="ReverseOrder" Value="True" />
      <Setter Property="VerticalAlignment" Value="Bottom" />
      <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
  </ControlTheme>

</ResourceDictionary>
