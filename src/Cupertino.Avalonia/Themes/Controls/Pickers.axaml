<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:motion="clr-namespace:Cupertino.Animation">

  <ControlTheme x:Key="CupertinoPickerCapsule" TargetType="Button">
    <Setter Property="Background" Value="{DynamicResource CupertinoPickerFieldBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource CupertinoLabelBrush}" />
    <Setter Property="FontSize" Value="{DynamicResource CupertinoFontSize17}" />
    <Setter Property="MinHeight" Value="34" />
    <Setter Property="Padding" Value="13,0" />
    <Setter Property="CornerRadius" Value="17" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel>
          <Border Background="{TemplateBinding Background}"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter Content="{TemplateBinding Content}"
                              HorizontalContentAlignment="Center"
                              VerticalContentAlignment="Center" />
          </Border>
          <Border x:Name="FocusRing" IsHitTestVisible="False"
                  CornerRadius="999" Margin="-2"
                  BorderBrush="{DynamicResource CupertinoFocusRingBrush}"
                  BorderThickness="2" Opacity="0" />
        </Panel>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pressed">
      <Setter Property="Opacity" Value="0.55" />
    </Style>
    <Style Selector="^:focus-visible /template/ Border#FocusRing">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Opacity" Value="0.4" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type DatePicker}" TargetType="DatePicker">
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="FontSize" Value="{DynamicResource CupertinoFontSize17}" />
    <Setter Property="Foreground" Value="{DynamicResource CupertinoLabelBrush}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel>
          <Button x:Name="PART_FlyoutButton"
                  Theme="{StaticResource CupertinoPickerCapsule}"
                  AutomationProperties.Name="{Binding SelectedDate, RelativeSource={RelativeSource TemplatedParent}, StringFormat='{}{0:d}'}">
            <Grid x:Name="PART_ButtonContentGrid" ColumnDefinitions="Auto,Auto,Auto,Auto,Auto">
              <TextBlock x:Name="PART_DayTextBlock" Grid.Column="0" />
              <Rectangle x:Name="PART_FirstSpacer" Grid.Column="1" Width="6" Fill="Transparent" />
              <TextBlock x:Name="PART_MonthTextBlock" Grid.Column="2" />
              <Rectangle x:Name="PART_SecondSpacer" Grid.Column="3" Width="6" Fill="Transparent" />
              <TextBlock x:Name="PART_YearTextBlock" Grid.Column="4" />
            </Grid>
          </Button>
          <Popup x:Name="PART_Popup" IsLightDismissEnabled="True"
                 PlacementTarget="{Binding #PART_FlyoutButton}"
                 Placement="BottomEdgeAlignedLeft">
            <Panel Classes="cupertino-popover" Margin="18,10,18,18">
              <Border Background="{DynamicResource CupertinoMenuPanelBrush}"
                      CornerRadius="14"
                      BoxShadow="0 10 30 0 #33000000">
                <DatePickerPresenter x:Name="PART_PickerPresenter" />
              </Border>
            </Panel>
          </Popup>
        </Panel>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:disabled">
      <Setter Property="Opacity" Value="0.4" />
    </Style>
    <Style Selector="^ /template/ Panel.cupertino-popover">
      <Setter Property="RenderTransformOrigin" Value="50%,0%" />
      <Style.Animations>
        <Animation Duration="{motion:MotionDuration 180}" Easing="QuadraticEaseOut">
          <KeyFrame Cue="0%">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="ScaleTransform.ScaleX" Value="0.94" />
            <Setter Property="ScaleTransform.ScaleY" Value="0.94" />
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="ScaleTransform.ScaleX" Value="1" />
            <Setter Property="ScaleTransform.ScaleY" Value="1" />
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type TimePicker}" TargetType="TimePicker">
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="FontSize" Value="{DynamicResource CupertinoFontSize17}" />
    <Setter Property="Foreground" Value="{DynamicResource CupertinoLabelBrush}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel>
          <Button x:Name="PART_FlyoutButton"
                  Theme="{StaticResource CupertinoPickerCapsule}"
                  AutomationProperties.Name="{Binding SelectedTime, RelativeSource={RelativeSource TemplatedParent}, StringFormat='{}{0:t}'}">
            <Grid x:Name="PART_FlyoutButtonContentGrid" ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto">
              <Border x:Name="PART_FirstPickerHost" Grid.Column="0">
                <TextBlock x:Name="PART_HourTextBlock" />
              </Border>
              <Rectangle x:Name="PART_FirstColumnDivider" Grid.Column="1" Width="2" Fill="Transparent" />
              <Border x:Name="PART_SecondPickerHost" Grid.Column="2">
                <TextBlock x:Name="PART_MinuteTextBlock" />
              </Border>
              <Rectangle x:Name="PART_SecondColumnDivider" Grid.Column="3" Width="2" Fill="Transparent" />
              <Border x:Name="PART_ThirdPickerHost" Grid.Column="4">
                <TextBlock x:Name="PART_SecondTextBlock" />
              </Border>
              <Rectangle x:Name="PART_ThirdColumnDivider" Grid.Column="5" Width="6" Fill="Transparent" />
              <Border x:Name="PART_FourthPickerHost" Grid.Column="6">
                <TextBlock x:Name="PART_PeriodTextBlock" />
              </Border>
            </Grid>
          </Button>
          <Popup x:Name="PART_Popup" IsLightDismissEnabled="True"
                 PlacementTarget="{Binding #PART_FlyoutButton}"
                 Placement="BottomEdgeAlignedLeft">
            <Panel Classes="cupertino-popover" Margin="18,10,18,18">
              <Border Background="{DynamicResource CupertinoMenuPanelBrush}"
                      CornerRadius="14"
                      BoxShadow="0 10 30 0 #33000000">
                <TimePickerPresenter x:Name="PART_PickerPresenter" />
              </Border>
            </Panel>
          </Popup>
        </Panel>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:disabled">
      <Setter Property="Opacity" Value="0.4" />
    </Style>
    <Style Selector="^ /template/ Panel.cupertino-popover">
      <Setter Property="RenderTransformOrigin" Value="50%,0%" />
      <Style.Animations>
        <Animation Duration="{motion:MotionDuration 180}" Easing="QuadraticEaseOut">
          <KeyFrame Cue="0%">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="ScaleTransform.ScaleX" Value="0.94" />
            <Setter Property="ScaleTransform.ScaleY" Value="0.94" />
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="ScaleTransform.ScaleX" Value="1" />
            <Setter Property="ScaleTransform.ScaleY" Value="1" />
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
  </ControlTheme>

</ResourceDictionary>
