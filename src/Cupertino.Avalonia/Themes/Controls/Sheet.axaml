<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="using:Cupertino.Controls">

  <ControlTheme x:Key="{x:Type controls:CupertinoSheetPresenter}"
                TargetType="controls:CupertinoSheetPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="CornerRadius" Value="36" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border CornerRadius="{TemplateBinding CornerRadius}"
                BoxShadow="0 6 32 0 #14000000"
                ClipToBounds="False">
          <Border CornerRadius="{TemplateBinding CornerRadius}" ClipToBounds="True">
            <Panel>
              <!-- Frost only; the scrim and shadow live outside. -->
              <controls:GlassSurface CornerRadius="{TemplateBinding CornerRadius}"
                                     BlurRadius="30" Saturation="1.3"
                                     GlassThickness="0" RefractionStrength="0"
                                     ChromaticAberration="0" DepthEffect="0"
                                     LightIntensity="0" FresnelStrength="0"
                                     ShadowOpacity="0" Magnification="1"
                                     IsAdaptive="False" IsLive="True"
                                     Tint="{DynamicResource CupertinoSheetTint}" />
              <ContentPresenter Name="PART_ContentPresenter"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                Margin="0,20,0,0" />
              <Border Width="36" Height="5" CornerRadius="2.5"
                      VerticalAlignment="Top" HorizontalAlignment="Center"
                      Margin="0,5,0,0"
                      Background="{DynamicResource CupertinoSheetGrabberBrush}" />
            </Panel>
          </Border>
        </Border>
      </ControlTemplate>
    </Setter>
  </ControlTheme>
</ResourceDictionary>
