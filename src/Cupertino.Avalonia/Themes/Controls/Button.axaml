<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:motion="clr-namespace:Cupertino.Animation"
                    xmlns:controls="clr-namespace:Cupertino.Controls">

  <ControlTheme x:Key="CupertinoButton" TargetType="Button">
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="Foreground" Value="{DynamicResource CupertinoLabelBrush}" />
    <Setter Property="FontSize" Value="{DynamicResource CupertinoFontSize17}" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Padding" Value="14,7" />
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="ClipToBounds" Value="False" />
    <Setter Property="RenderTransform" Value="scale(1.0)" />
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="{motion:MotionDuration 130}" Easing="SineEaseOut" />
        <DoubleTransition Property="Opacity" Duration="{motion:MotionDuration 100}" />
      </Transitions>
    </Setter>
    <Setter Property="Template">
      <ControlTemplate>
        <Panel ClipToBounds="False">
          <controls:GlassSurface x:Name="GlassBg"
                                 CornerRadius="999"
                                 BlurRadius="12"
                                 GlassThickness="1"
                                 RefractionStrength="7"
                                 ChromaticAberration="0.2"
                                 DepthEffect="0.25"
                                 Saturation="0.65"
                                 LightIntensity="0.15"
                                 FresnelStrength="0.30"
                                 ShadowOpacity="0.1" ShadowBlur="24" ShadowOffset="2"
                                 ShadowContactWeight="0"
                                 Tint="{DynamicResource CupertinoGlassButtonTint}">
            <controls:GlassSurface.Transitions>
              <Transitions>
                <ColorTransition Property="Tint" Duration="{motion:MotionDuration 130}" />
              </Transitions>
            </controls:GlassSurface.Transitions>
          </controls:GlassSurface>
          <Border x:Name="FlatBg"
                  CornerRadius="999"
                  IsVisible="False"
                  Background="{DynamicResource CupertinoBorderedFillBrush}" />
          <!-- The resting prominent material has a thin luminous rim. -->
          <Border x:Name="ProminentRim" CornerRadius="999" IsVisible="False"
                  BorderThickness="0.667" IsHitTestVisible="False"
                  BorderBrush="{DynamicResource CupertinoProminentRimBrush}" />
          <ContentPresenter x:Name="PART_ContentPresenter"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Padding="{TemplateBinding Padding}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                            Background="Transparent" />
          <Border x:Name="FocusRing"
                  CornerRadius="999"
                  Margin="-4"
                  BorderBrush="{DynamicResource CupertinoFocusRingBrush}"
                  BorderThickness="2"
                  Opacity="0">
            <Border.Transitions>
              <Transitions>
                <DoubleTransition Property="Opacity" Duration="{motion:MotionDuration 100}" />
              </Transitions>
            </Border.Transitions>
          </Border>
        </Panel>
      </ControlTemplate>
    </Setter>

    <Style Selector="^:pointerover /template/ controls|GlassSurface#GlassBg">
      <Setter Property="LightIntensity" Value="1.0" />
    </Style>
    <Style Selector="^:pressed">
      <Setter Property="RenderTransform" Value="scale(1.04)" />
    </Style>
    <Style Selector="^:pressed /template/ controls|GlassSurface#GlassBg">
      <Setter Property="LightIntensity" Value="1.4" />
    </Style>

    <Style Selector="^.prominent">
      <Setter Property="Foreground" Value="{DynamicResource CupertinoProminentForegroundBrush}" />
      <Setter Property="FontWeight" Value="Normal" />
    </Style>
    <Style Selector="^.prominent /template/ Border#ProminentRim">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="^.prominent /template/ controls|GlassSurface#GlassBg">
      <Setter Property="IsAdaptive" Value="False" />
      <Setter Property="Tint" Value="{DynamicResource CupertinoProminentTint}" />
      <Setter Property="Saturation" Value="1.0" />
      <Setter Property="ChromaticAberration" Value="0.05" />
      <Setter Property="DepthEffect" Value="0.12" />
      <Setter Property="LightIntensity" Value="0.15" />
      <Setter Property="FresnelStrength" Value="0.18" />
      <Setter Property="GlassThickness" Value="1" />
      <Setter Property="ShadowContactWeight" Value="0" />
      <Setter Property="ShadowOpacity" Value="0.1" />
      <Setter Property="ShadowBlur" Value="24" />
      <Setter Property="ShadowOffset" Value="1" />
    </Style>
    <Style Selector="^.prominent:pressed">
      <Setter Property="RenderTransform" Value="scale(1.16,1.22)" />
    </Style>
    <Style Selector="^.prominent:pressed /template/ controls|GlassSurface#GlassBg">
      <Setter Property="Tint" Value="{DynamicResource CupertinoProminentPressedTint}" />
    </Style>

    <Style Selector="^.bordered">
      <Setter Property="Foreground" Value="{DynamicResource CupertinoAccentBrush}" />
    </Style>
    <Style Selector="^.bordered /template/ controls|GlassSurface#GlassBg">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="^.bordered /template/ Border#FlatBg">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="^.bordered:pressed">
      <Setter Property="RenderTransform" Value="scale(1.0)" />
      <Setter Property="Opacity" Value="0.6" />
    </Style>

    <Style Selector="^.plain">
      <Setter Property="Foreground" Value="{DynamicResource CupertinoAccentBrush}" />
      <Setter Property="FontWeight" Value="Normal" />
    </Style>
    <Style Selector="^.plain /template/ controls|GlassSurface#GlassBg">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="^.plain:pressed">
      <Setter Property="RenderTransform" Value="scale(1.0)" />
      <Setter Property="Opacity" Value="0.75" />
    </Style>

    <Style Selector="^.small">
      <Setter Property="MinHeight" Value="28" />
      <Setter Property="Padding" Value="11,4" />
      <Setter Property="FontSize" Value="{DynamicResource CupertinoFontSize15}" />
    </Style>

    <Style Selector="^.large">
      <Setter Property="MinHeight" Value="50" />
      <Setter Property="Padding" Value="20,12" />
    </Style>

    <Style Selector="^:focus-visible /template/ Border#FocusRing">
      <Setter Property="Opacity" Value="1" />
    </Style>

    <Style Selector="^:disabled">
      <Setter Property="Opacity" Value="0.5" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type Button}"
                TargetType="Button"
                BasedOn="{StaticResource CupertinoButton}" />

</ResourceDictionary>
