<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:motion="clr-namespace:Cupertino.Animation"
                    xmlns:controls="clr-namespace:Cupertino.Controls">

  <ControlTheme x:Key="{x:Type MenuItem}" TargetType="MenuItem">
    <Setter Property="Foreground" Value="{DynamicResource CupertinoLabelBrush}" />
    <Setter Property="FontSize" Value="{DynamicResource CupertinoFontSize17}" />
    <Setter Property="MinHeight" Value="44" />
    <Setter Property="Padding" Value="16,0" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel>
          <Border x:Name="Row" Background="Transparent">
            <Border.Transitions>
              <Transitions>
                <BrushTransition Property="Background" Duration="{motion:MotionDuration 180}" />
              </Transitions>
            </Border.Transitions>
          </Border>
          <Grid ColumnDefinitions="Auto,*,Auto" Margin="{TemplateBinding Padding}">
            <ContentPresenter Content="{TemplateBinding Icon}"
                              IsVisible="{TemplateBinding Icon, Converter={x:Static ObjectConverters.IsNotNull}}"
                              Width="26" Margin="0,0,10,0"
                              HorizontalContentAlignment="Center"
                              VerticalAlignment="Center" />
            <ContentPresenter Grid.Column="1"
                              Content="{TemplateBinding Header}"
                              VerticalAlignment="Center" />
            <Path x:Name="SubChevron" Grid.Column="2"
                  Data="{StaticResource CupertinoChevronRightGeometry}"
                  Stroke="{DynamicResource CupertinoTertiaryLabelBrush}"
                  StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round"
                  Width="16" Height="16" Stretch="None"
                  Margin="8,0,0,0" VerticalAlignment="Center" />
          </Grid>
          <Popup x:Name="PART_Popup"
                 IsOpen="{TemplateBinding IsSubMenuOpen, Mode=TwoWay}"
                 controls:CupertinoFlyoutTransition.IsEnabled="True"
                 Placement="RightEdgeAlignedTop">
            <Panel Classes="cupertino-popover source-transition" Margin="18,10,18,18">
              <Grid MinWidth="220">
                <controls:GlassSurface Classes="source-transition-material" CornerRadius="26"
                                       BlurRadius="36" Saturation="1.8"
                                       Tint="{DynamicResource CupertinoPopoverTint}"
                                       GlassThickness="0.35" RefractionStrength="0.10"
                                       ChromaticAberration="0" DepthEffect="0.25"
                                       IsAdaptive="True"
                                       ShadowOpacity="0.14" ShadowBlur="18" ShadowOffset="6" />
                <Border Classes="source-transition-content" CornerRadius="26" ClipToBounds="True">
                  <ItemsPresenter Name="PART_ItemsPresenter"
                                  ItemsPanel="{TemplateBinding ItemsPanel}"
                                  Margin="0,6" />
                </Border>
              </Grid>
            </Panel>
          </Popup>
        </Panel>
      </ControlTemplate>
    </Setter>

    <Style Selector="^:empty /template/ Path#SubChevron">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="^:pointerover /template/ Border#Row">
      <Setter Property="Background" Value="{DynamicResource CupertinoMenuRowHoverBrush}" />
    </Style>
    <Style Selector="^:selected /template/ Border#Row">
      <Setter Property="Background" Value="{DynamicResource CupertinoMenuRowHoverBrush}" />
    </Style>
    <Style Selector="^:pressed /template/ Border#Row">
      <Setter Property="Background" Value="{DynamicResource CupertinoMenuRowPressedBrush}" />
    </Style>
    <Style Selector="^.destructive">
      <Setter Property="Foreground" Value="{DynamicResource CupertinoDangerBrush}" />
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Opacity" Value="0.4" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type Separator}" TargetType="Separator">
    <Setter Property="Height" Value="0.5" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="Background" Value="{DynamicResource CupertinoSeparatorBrush}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}" Height="0.5" />
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type MenuFlyoutPresenter}" TargetType="MenuFlyoutPresenter">
    <Setter Property="Template">
      <ControlTemplate>
        <Panel Classes="cupertino-popover source-transition" Margin="18,10,18,18">
          <Grid MinWidth="220">
            <controls:GlassSurface Classes="source-transition-material" CornerRadius="26"
                                     BlurRadius="36" Saturation="1.8"
                                     Tint="{DynamicResource CupertinoPopoverTint}"
                                     GlassThickness="0.35" RefractionStrength="0.10"
                                     ChromaticAberration="0" DepthEffect="0.25"
                                     IsAdaptive="True"
                                     ShadowOpacity="0.14" ShadowBlur="18" ShadowOffset="6" />
            <Border Classes="source-transition-content" CornerRadius="26" ClipToBounds="True">
              <ItemsPresenter Name="PART_ItemsPresenter"
                              ItemsPanel="{TemplateBinding ItemsPanel}"
                              Margin="0,6" />
            </Border>
          </Grid>
        </Panel>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

</ResourceDictionary>
