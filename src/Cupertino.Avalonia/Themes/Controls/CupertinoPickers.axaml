<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:motion="clr-namespace:Cupertino.Animation"
                    xmlns:controls="clr-namespace:Cupertino.Controls">

  <!-- Overlay-hosted pickers can sample the application backdrop. -->

  <ControlTheme x:Key="CupertinoPickerFieldButton" TargetType="Button"
                BasedOn="{StaticResource CupertinoPickerCapsule}">
    <Setter Property="Height" Value="36" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="CornerRadius" Value="999" />
  </ControlTheme>

  <ControlTheme x:Key="{x:Type controls:CupertinoCalendarView}" TargetType="controls:CupertinoCalendarView">
    <Setter Property="Template">
      <ControlTemplate>
        <StackPanel Margin="16,12,16,16">
          <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,6">
            <Button x:Name="PART_TitleButton" Grid.Column="0"
                    Theme="{StaticResource CupertinoCalendarHeaderButton}"
                    AutomationProperties.Name="{Binding #PART_Title.Text}"
                    HorizontalAlignment="Left">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock x:Name="PART_Title"
                           FontSize="{DynamicResource CupertinoFontSize17}" FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource CupertinoLabelBrush}" />
                <Path x:Name="TitleChevron"
                      Data="{StaticResource CupertinoChevronRightGeometry}"
                      Stroke="{DynamicResource CupertinoAccentBrush}"
                      StrokeThickness="2.2" StrokeLineCap="Round" StrokeJoin="Round"
                      Width="16" Height="16" Stretch="None"
                      VerticalAlignment="Center"
                      RenderTransformOrigin="50%,50%" RenderTransform="rotate(0deg)">
                  <Path.Transitions>
                    <Transitions>
                      <TransformOperationsTransition Property="RenderTransform" Duration="{motion:MotionDuration 200}" Easing="SineEaseOut" />
                    </Transitions>
                  </Path.Transitions>
                </Path>
              </StackPanel>
            </Button>
            <Button Grid.Column="1" x:Name="PART_PreviousButton"
                    Theme="{StaticResource CupertinoCalendarPagingButton}"
                    AutomationProperties.Name="{DynamicResource CupertinoPreviousMonthText}">
              <Path Data="{StaticResource CupertinoChevronLeftGeometry}"
                    Stroke="{DynamicResource CupertinoLabelBrush}"
                    StrokeThickness="2.5" StrokeLineCap="Round" StrokeJoin="Round"
                    Width="16" Height="16" Stretch="None"
                    RenderTransformOrigin="50%,50%" RenderTransform="scale(1.35)" />
            </Button>
            <Button Grid.Column="2" x:Name="PART_NextButton"
                    Theme="{StaticResource CupertinoCalendarPagingButton}"
                    AutomationProperties.Name="{DynamicResource CupertinoNextMonthText}">
              <Path Data="{StaticResource CupertinoChevronRightGeometry}"
                    Stroke="{DynamicResource CupertinoLabelBrush}"
                    StrokeThickness="2.5" StrokeLineCap="Round" StrokeJoin="Round"
                    Width="16" Height="16" Stretch="None"
                    RenderTransformOrigin="50%,50%" RenderTransform="scale(1.35)" />
            </Button>
          </Grid>

          <Panel Width="298">
            <controls:CupertinoMonthGrid x:Name="PART_Grid"
                                  DisplayMonth="{TemplateBinding DisplayMonth}"
                                  SelectedDate="{Binding SelectedDate, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                  MinimumDate="{TemplateBinding MinimumDate}"
                                  MaximumDate="{TemplateBinding MaximumDate}"
                                  FirstDayOfWeek="{TemplateBinding FirstDayOfWeek}"
                                  Foreground="{DynamicResource CupertinoLabelBrush}"
                                  AccentBrush="{DynamicResource CupertinoAccentBrush}"
                                  SelectionBrush="{DynamicResource CupertinoAccentBrush}"
                                  SelectionForeground="{DynamicResource CupertinoLabelOnGlassBrush}"
                                  WeekdayBrush="{DynamicResource CupertinoTertiaryLabelBrush}" />

            <Panel x:Name="MonthPicker" Height="216" IsVisible="False">
              <Border Background="{DynamicResource CupertinoPickerHighlightBrush}"
                      CornerRadius="17" Height="34"
                      HorizontalAlignment="Stretch" VerticalAlignment="Center" />
              <StackPanel Orientation="Horizontal" Spacing="32"
                          HorizontalAlignment="Center">
                <controls:CupertinoWheel x:Name="PART_MonthWheel" TextAlignment="Left"
                                  Foreground="{DynamicResource CupertinoLabelBrush}" />
                <controls:CupertinoWheel x:Name="PART_YearWheel" TextAlignment="Left"
                                  Foreground="{DynamicResource CupertinoLabelBrush}" />
              </StackPanel>
            </Panel>
          </Panel>
        </StackPanel>
      </ControlTemplate>
    </Setter>

    <Style Selector="^:monthpicker /template/ Path#TitleChevron">
      <Setter Property="RenderTransform" Value="rotate(90deg)" />
    </Style>
    <Style Selector="^:monthpicker /template/ TextBlock#PART_Title">
      <Setter Property="Foreground" Value="{DynamicResource CupertinoAccentBrush}" />
    </Style>
    <Style Selector="^:monthpicker /template/ controls|CupertinoMonthGrid#PART_Grid">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="^:monthpicker /template/ Panel#MonthPicker">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="^:monthpicker /template/ Button#PART_PreviousButton">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="^:monthpicker /template/ Button#PART_NextButton">
      <Setter Property="IsVisible" Value="False" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type controls:CupertinoDatePicker}" TargetType="controls:CupertinoDatePicker">
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Template">
      <ControlTemplate>
        <Grid>
          <Button x:Name="PART_FlyoutButton"
                  Theme="{StaticResource CupertinoPickerFieldButton}"
                  Content="{TemplateBinding DisplayText}"
                  AutomationProperties.Name="{Binding DisplayText, RelativeSource={RelativeSource TemplatedParent}}" />
          <controls:CupertinoCalendarView x:Name="PART_InlineCalendar" IsVisible="False" />
        </Grid>
      </ControlTemplate>
    </Setter>

    <Style Selector="^:dropdownopen /template/ Button#PART_FlyoutButton">
      <Setter Property="Foreground" Value="{DynamicResource CupertinoAccentBrush}" />
    </Style>
    <Style Selector="^:inline /template/ Button#PART_FlyoutButton">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="^:inline /template/ controls|CupertinoCalendarView#PART_InlineCalendar">
      <Setter Property="IsVisible" Value="True" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type controls:CupertinoTimePicker}" TargetType="controls:CupertinoTimePicker">
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Template">
      <ControlTemplate>
        <Grid>
          <Button x:Name="PART_FlyoutButton"
                  Theme="{StaticResource CupertinoPickerFieldButton}"
                  AutomationProperties.Name="{Binding DisplayText, RelativeSource={RelativeSource TemplatedParent}}">
            <TextBlock Text="{TemplateBinding DisplayText}" FontFeatures="tnum" />
          </Button>
          <ContentControl x:Name="PART_InlineHost" IsVisible="False" />
        </Grid>
      </ControlTemplate>
    </Setter>

    <Style Selector="^:dropdownopen /template/ Button#PART_FlyoutButton">
      <Setter Property="Foreground" Value="{DynamicResource CupertinoAccentBrush}" />
    </Style>
    <Style Selector="^:inline /template/ Button#PART_FlyoutButton"><Setter Property="IsVisible" Value="False" /></Style>
    <Style Selector="^:inline /template/ ContentControl#PART_InlineHost"><Setter Property="IsVisible" Value="True" /></Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type controls:CupertinoDateTimePicker}" TargetType="controls:CupertinoDateTimePicker">
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="Template">
      <ControlTemplate>
        <StackPanel Orientation="Horizontal" Spacing="4">
          <controls:CupertinoDatePicker x:Name="PART_Date" />
          <controls:CupertinoTimePicker x:Name="PART_Time" />
        </StackPanel>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

</ResourceDictionary>
