<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:Cupertino.Controls">

  <ControlTheme x:Key="{x:Type controls:ToolbarSpacer}" TargetType="controls:ToolbarSpacer">
    <Setter Property="IsHitTestVisible" Value="False" />
  </ControlTheme>

  <ControlTheme x:Key="CupertinoToolbarButton" TargetType="Button">
    <Setter Property="Foreground" Value="{DynamicResource CupertinoBarForegroundBrush}" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="MinWidth" Value="48" />
    <Setter Property="Height" Value="48" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel Background="Transparent">
          <ContentPresenter Name="PART_ContentPresenter"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center" />
        </Panel>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pressed">
      <Setter Property="Opacity" Value="0.4" />
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Opacity" Value="0.35" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type controls:CupertinoToolbar}" TargetType="controls:CupertinoToolbar">
    <Setter Property="ClipToBounds" Value="False" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Bottom" />
    <Setter Property="Margin" Value="35,0,35,32" />
    <Setter Property="MinHeight" Value="48" />
    <Setter Property="Template">
      <ControlTemplate>
        <Grid x:Name="PART_Groups" ClipToBounds="False" />
      </ControlTemplate>
    </Setter>
    <Style Selector="^.embedded">
      <Setter Property="Margin" Value="0" />
    </Style>
  </ControlTheme>
</ResourceDictionary>
