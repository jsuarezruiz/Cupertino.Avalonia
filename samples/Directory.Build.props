<Project>
  <Import Project="../Directory.Build.props" />

  <PropertyGroup>
    <!-- App manifests need a numeric display version; assemblies retain the preview suffix. -->
    <ApplicationDisplayVersion Condition="'$(ApplicationDisplayVersion)' == ''">$([System.Text.RegularExpressions.Regex]::Replace('$(Version)', '[+-].*$', ''))</ApplicationDisplayVersion>
    <!-- CI supplies an increasing build number. Local builds can override ApplicationVersion. -->
    <ApplicationVersion Condition="'$(ApplicationVersion)' == '' and '$(GITHUB_RUN_NUMBER)' != ''">$(GITHUB_RUN_NUMBER)</ApplicationVersion>
    <ApplicationVersion Condition="'$(ApplicationVersion)' == ''">1</ApplicationVersion>
    <ApplicationTitle>Cupertino Gallery</ApplicationTitle>
    <AssemblyTitle>Cupertino Gallery</AssemblyTitle>
    <Product>Cupertino.Avalonia Gallery</Product>
    <Authors>Javier Suárez Ruiz</Authors>
    <Company>Javier Suárez Ruiz</Company>
    <Description>Interactive control gallery for the Cupertino.Avalonia iOS 26 design system.</Description>
    <Copyright>Copyright © 2026 Javier Suárez Ruiz</Copyright>
    <NeutralLanguage>en</NeutralLanguage>
  </PropertyGroup>
</Project>
