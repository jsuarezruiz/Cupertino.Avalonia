<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cupertino="https://cupertino.avaloniaui.net"
             x:Class="Cupertino.Gallery.HomePage">

  <UserControl.Styles>
    <Style Selector="TextBlock.stat">
      <Setter Property="FontSize" Value="26" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="{DynamicResource CupertinoLabelBrush}" />
    </Style>
    <Style Selector="TextBlock.statLabel">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource CupertinoSecondaryLabelBrush}" />
    </Style>
    <Style Selector="TextBlock.feature">
      <Setter Property="FontSize" Value="17" />
      <Setter Property="Foreground" Value="{DynamicResource CupertinoLabelBrush}" />
    </Style>
    <Style Selector="TextBlock.featureBody">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Foreground" Value="{DynamicResource CupertinoSecondaryLabelBrush}" />
    </Style>
  </UserControl.Styles>

  <ScrollViewer>
    <StackPanel Margin="0,150,0,120">

      <TextBlock x:Name="Intro"
                 Text="An iOS 26 design system for Avalonia: controls, typography, colour and motion."
                 FontSize="15" Margin="20,0,20,22" TextWrapping="Wrap"
                 Foreground="{DynamicResource CupertinoSecondaryLabelBrush}" />

      <cupertino:Section Header="MATERIAL"
                         Footer="GlassSurface creates a glass background that blurs and distorts the content behind it. Compare more examples in Liquid Glass.">
        <Panel Height="188" Margin="16,14">
          <Border CornerRadius="18" ClipToBounds="True">
            <Panel>
              <Border>
                <Border.Background>
                  <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                    <GradientStop Offset="0.0" Color="#FF3A1C71" />
                    <GradientStop Offset="0.5" Color="#FFD76D77" />
                    <GradientStop Offset="1.0" Color="#FFFFAF7B" />
                  </LinearGradientBrush>
                </Border.Background>
              </Border>
              <Ellipse Width="150" Height="150" Margin="-40,-30,0,0"
                       HorizontalAlignment="Left" VerticalAlignment="Top" Opacity="0.7">
                <Ellipse.Fill>
                  <RadialGradientBrush>
                    <GradientStop Offset="0" Color="#FF4CC2FF" />
                    <GradientStop Offset="1" Color="#0000C2FF" />
                  </RadialGradientBrush>
                </Ellipse.Fill>
              </Ellipse>
            </Panel>
          </Border>

          <cupertino:GlassSurface CornerRadius="20" IsLive="True"
                                  Width="236" Height="116"
                                  BlurRadius="24" GlassThickness="11"
                                  RefractionStrength="18" ChromaticAberration="0.5"
                                  DepthEffect="0.28" Saturation="1.3"
                                  LightIntensity="0.9" FresnelStrength="1.2"
                                  ShadowOpacity="0.26" ShadowBlur="28" ShadowOffset="10">
            <StackPanel Margin="18,16" Spacing="6">
              <TextBlock Text="GlassSurface" FontSize="17" FontWeight="SemiBold"
                         Foreground="White" />
              <TextBlock Text="A reusable glass background for your content."
                         FontSize="12" TextWrapping="Wrap" Foreground="#D9FFFFFF" />
            </StackPanel>
          </cupertino:GlassSurface>
        </Panel>
      </cupertino:Section>

      <cupertino:Section Header="AT A GLANCE">
        <Grid ColumnDefinitions="*,*,*" Margin="16,16">
          <StackPanel Spacing="1">
            <TextBlock Classes="stat" Text="Themes" />
            <TextBlock Classes="statLabel" Text="light and dark" />
          </StackPanel>
          <StackPanel Grid.Column="1" Spacing="1">
            <TextBlock Classes="stat" Text="Input" />
            <TextBlock Classes="statLabel" Text="touch and mouse" />
          </StackPanel>
          <StackPanel Grid.Column="2" Spacing="1">
            <TextBlock Classes="stat" Text="Motion" />
            <TextBlock Classes="statLabel" Text="animated states" />
          </StackPanel>
        </Grid>
      </cupertino:Section>

      <cupertino:Section Header="HOW IT IS BUILT"
                         Footer="Explore the control examples, or open Settings to try different appearances, colours, and accessibility options.">
        <StackPanel>
          <StackPanel Spacing="3" Margin="16,12">
            <TextBlock Classes="feature" Text="Try the interactions" />
            <TextBlock Classes="featureBody"
                       Text="Scroll a picker wheel, drag between tabs, or scroll a page to see its large navigation title become compact." />
          </StackPanel>
          <Rectangle Classes="hair" />
          <StackPanel Spacing="3" Margin="16,12">
            <TextBlock Classes="feature" Text="Familiar Avalonia controls" />
            <TextBlock Classes="featureBody"
                       Text="The theme styles Avalonia controls such as buttons, switches, and sliders. Additional Cupertino controls provide navigation, sheets, and wheel pickers." />
          </StackPanel>
          <Rectangle Classes="hair" />
          <StackPanel Spacing="3" Margin="16,12">
            <TextBlock Classes="feature" Text="Accessibility options" />
            <TextBlock Classes="featureBody"
                       Text="Try Reduce transparency for opaque backgrounds and Reduce motion for less animation. Both options are available in Settings." />
          </StackPanel>
        </StackPanel>
      </cupertino:Section>

    </StackPanel>
  </ScrollViewer>
</UserControl>
