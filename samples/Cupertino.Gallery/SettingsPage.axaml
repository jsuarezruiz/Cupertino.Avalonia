<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cupertino="https://cupertino.avaloniaui.net"
             x:Class="Cupertino.Gallery.SettingsPage">

  <ScrollViewer>
    <StackPanel Margin="0,74,0,120">

      <cupertino:Section Header="APPEARANCE"
                         Footer="Choose a light or dark appearance, or follow the system. Reduce transparency uses opaque backgrounds; Reduce motion limits animations in the gallery.">
        <StackPanel Margin="16,14" Spacing="12">
          <TabStrip x:Name="AppearanceStrip" Classes="segmented" SelectedIndex="0"
                    SelectionChanged="OnAppearanceChanged">
            <TabStripItem Content="Automatic" />
            <TabStripItem Content="Light" />
            <TabStripItem Content="Dark" />
          </TabStrip>

          <Grid ColumnDefinitions="*,Auto" Margin="0,2,0,0">
            <TextBlock Text="Reduce transparency" FontSize="17"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource CupertinoLabelBrush}" />
            <ToggleSwitch x:Name="ReduceGlass" Grid.Column="1"
                          AutomationProperties.Name="Reduce transparency"
                          IsCheckedChanged="OnReduceGlassChanged" />
          </Grid>

          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="Reduce motion" FontSize="17"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource CupertinoLabelBrush}" />
            <ToggleSwitch x:Name="ReduceMotion" Grid.Column="1"
                          AutomationProperties.Name="Reduce motion"
                          IsCheckedChanged="OnReduceMotionChanged" />
          </Grid>
        </StackPanel>
      </cupertino:Section>

      <cupertino:Section Header="LAYOUT DIRECTION"
                         Footer="System follows the current interface language. Choose LTR (left to right) or RTL (right to left) to preview the gallery in that direction.">
        <StackPanel Margin="16,14" Spacing="8">
          <TextBlock Text="Direction" FontSize="17"
                     Foreground="{DynamicResource CupertinoLabelBrush}" />
          <TabStrip x:Name="DirectionStrip" Classes="segmented"
                    SelectionChanged="OnDirectionChanged">
            <TabStripItem Content="System" />
            <TabStripItem Content="LTR" />
            <TabStripItem Content="RTL" />
          </TabStrip>
        </StackPanel>
      </cupertino:Section>

      <cupertino:Section Header="ACCENT"
                         Footer="Choose an accent colour for buttons, focus indicators, and selections. The change applies to both light and dark appearances.">
        <StackPanel x:Name="AccentRow" Orientation="Horizontal" Spacing="12" Margin="16,14" />
      </cupertino:Section>

      <cupertino:Section Header="ABOUT">
        <StackPanel>
          <StackPanel Margin="16,12" Spacing="6">
            <TextBlock Text="Cupertino.Avalonia" FontSize="17" FontWeight="SemiBold"
                       Foreground="{DynamicResource CupertinoLabelBrush}" />
            <TextBlock Text="An iOS design system for Avalonia"
                       FontSize="13" TextWrapping="Wrap"
                       Foreground="{DynamicResource CupertinoSecondaryLabelBrush}" />
          </StackPanel>
          <Rectangle Height="0.5" Fill="{DynamicResource CupertinoSeparatorBrush}"
                     Margin="16,0,0,0" />
          <Grid ColumnDefinitions="*,Auto" Height="44" Margin="16,0">
            <TextBlock Text="Version" FontSize="17" VerticalAlignment="Center"
                       Foreground="{DynamicResource CupertinoLabelBrush}" />
            <TextBlock x:Name="LibVersion" Grid.Column="1" FontSize="17"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource CupertinoSecondaryLabelBrush}" />
          </Grid>
          <Rectangle Height="0.5" Fill="{DynamicResource CupertinoSeparatorBrush}"
                     Margin="16,0,0,0" />
          <Grid ColumnDefinitions="*,Auto" Height="44" Margin="16,0">
            <TextBlock Text="Avalonia" FontSize="17" VerticalAlignment="Center"
                       Foreground="{DynamicResource CupertinoLabelBrush}" />
            <TextBlock x:Name="AvaloniaVersion" Grid.Column="1" FontSize="17"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource CupertinoSecondaryLabelBrush}" />
          </Grid>
          <Rectangle Height="0.5" Fill="{DynamicResource CupertinoSeparatorBrush}"
                     Margin="16,0,0,0" />
          <Grid ColumnDefinitions="*,Auto" Height="44" Margin="16,0">
            <TextBlock Text=".NET" FontSize="17" VerticalAlignment="Center"
                       Foreground="{DynamicResource CupertinoLabelBrush}" />
            <TextBlock x:Name="RuntimeVersion" Grid.Column="1" FontSize="17"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource CupertinoSecondaryLabelBrush}" />
          </Grid>
        </StackPanel>
      </cupertino:Section>

    </StackPanel>
  </ScrollViewer>
</UserControl>
