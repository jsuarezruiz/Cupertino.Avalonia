<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cupertino="https://cupertino.avaloniaui.net"
             x:Class="Cupertino.Gallery.Pages.DialogPage">

  <ScrollViewer>
    <StackPanel Margin="0,74,0,120">

    <cupertino:Section Header="BASIC"
                       Footer="Open an alert and choose an action. Dialog.ShowAsync returns the selected action so your app can respond. These examples only report your choice.">
      <StackPanel>
        <Grid Classes="case" ColumnDefinitions="Auto,*">
          <TextBlock Classes="case" Text="Message" />
          <WrapPanel Grid.Column="1" Classes="specimens">
            <Button Content="Show alert" Classes="bordered" Click="OnInfo" />
          </WrapPanel>
        </Grid>
        <Rectangle Classes="hair" />
        <Grid Classes="case" ColumnDefinitions="Auto,*">
          <TextBlock Classes="case" Text="Confirm" />
          <WrapPanel Grid.Column="1" Classes="specimens">
            <Button Content="Delete Photo…" Classes="bordered" Click="OnAlert" />
          </WrapPanel>
        </Grid>
      </StackPanel>
    </cupertino:Section>

    <cupertino:Section Header="CUSTOMIZED"
                       Footer="Give actions a role to distinguish cancellation and destructive choices. Use ShowSheetAsync to present a vertical list of actions.">
      <StackPanel>
        <Grid Classes="case" ColumnDefinitions="Auto,*">
          <TextBlock Classes="case" Text="Three actions" />
          <WrapPanel Grid.Column="1" Classes="specimens">
            <Button Content="Close document…" Classes="bordered" Click="OnThreeActions" />
          </WrapPanel>
        </Grid>
        <Rectangle Classes="hair" />
        <Grid Classes="case" ColumnDefinitions="Auto,*">
          <TextBlock Classes="case" Text="Action sheet" />
          <WrapPanel Grid.Column="1" Classes="specimens">
            <Button Content="Photo options…" Classes="bordered" Click="OnSheet" />
          </WrapPanel>
        </Grid>
        <Rectangle Classes="hair" />
        <Grid Classes="case" ColumnDefinitions="Auto,*">
          <TextBlock Classes="case" Text="Chosen" />
          <TextBlock x:Name="Result" Grid.Column="1" Text="—"
                     FontSize="15" VerticalAlignment="Center"
                     Foreground="{DynamicResource CupertinoSecondaryLabelBrush}" />
        </Grid>
      </StackPanel>
    </cupertino:Section>

    </StackPanel>
  </ScrollViewer>
</UserControl>
