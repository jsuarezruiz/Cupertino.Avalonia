<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cupertino="https://cupertino.avaloniaui.net"
             x:Class="Cupertino.Gallery.Pages.SwipeViewPage">

  <UserControl.Styles>
    <Style Selector="TextBlock.row">
      <Setter Property="Margin" Value="16,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource CupertinoLabelBrush}" />
    </Style>
  </UserControl.Styles>

  <ScrollViewer>
    <StackPanel Margin="0,74,0,120">

      <cupertino:Section Header="BASIC"
                         Footer="Swipe a row to reveal Delete, then select it or continue swiping to activate it. The result appears below; these examples keep the row in place.">
        <StackPanel>
          <cupertino:CupertinoSwipeView Height="44">
            <cupertino:CupertinoSwipeView.TrailingActions>
              <Button Classes="swipe swipe-destructive" Content="Delete" Click="OnDelete" />
            </cupertino:CupertinoSwipeView.TrailingActions>
            <TextBlock Classes="row" Text="Swipe to reveal Delete" />
          </cupertino:CupertinoSwipeView>
          <Rectangle Classes="hair" />
          <cupertino:CupertinoSwipeView Height="44">
            <cupertino:CupertinoSwipeView.TrailingActions>
              <Button Classes="swipe swipe-destructive" Content="Delete" Click="OnDelete" />
            </cupertino:CupertinoSwipeView.TrailingActions>
            <TextBlock Classes="row" Text="Try a full swipe on this row" />
          </cupertino:CupertinoSwipeView>
        </StackPanel>
      </cupertino:Section>

      <cupertino:Section Header="CUSTOMIZED"
                         Footer="Swipe in either direction to reveal different actions. This row offers Read on one side and Flag and Delete on the other.">
        <StackPanel>
          <cupertino:CupertinoSwipeView x:Name="RichRow" Height="52">
            <cupertino:CupertinoSwipeView.LeadingActions>
              <Button Classes="swipe" Content="Read" Click="OnAction"
                      Background="{DynamicResource CupertinoAccentBrush}" />
            </cupertino:CupertinoSwipeView.LeadingActions>
            <cupertino:CupertinoSwipeView.TrailingActions>
              <StackPanel Orientation="Horizontal">
                <Button Classes="swipe" Content="Flag" Click="OnAction"
                        Background="{DynamicResource CupertinoSystemOrangeBrush}" />
                <Button Classes="swipe swipe-destructive" Content="Delete" Click="OnDelete" />
              </StackPanel>
            </cupertino:CupertinoSwipeView.TrailingActions>
            <StackPanel VerticalAlignment="Center" Margin="16,0" Spacing="2">
              <TextBlock Classes="headline" Text="Team lunch"
                         Foreground="{DynamicResource CupertinoLabelBrush}" />
              <TextBlock Classes="footnote" Text="Swipe either way to see the actions"
                         Foreground="{DynamicResource CupertinoSecondaryLabelBrush}" />
            </StackPanel>
          </cupertino:CupertinoSwipeView>
        </StackPanel>
      </cupertino:Section>

      <cupertino:Section Header="RESULT">
        <TextBlock x:Name="Log" Classes="row" Margin="16,13" Text="No action yet" />
      </cupertino:Section>

    </StackPanel>
  </ScrollViewer>
</UserControl>
