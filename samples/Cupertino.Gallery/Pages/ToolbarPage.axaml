<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cupertino="https://cupertino.avaloniaui.net"
             x:Class="Cupertino.Gallery.Pages.ToolbarPage">

  <ScrollViewer>
    <StackPanel Margin="0,74,0,120">

      <cupertino:Section Header="BASIC"
                         Footer="Group related actions in a glass toolbar. Add a ToolbarSpacer to separate groups and distribute the available space.">
        <Grid Margin="16,11">
          <Border CornerRadius="10" ClipToBounds="True" Height="300">
            <Panel>
              <Image Source="avares://Cupertino.Gallery/Assets/Photos/harbor.jpg" Stretch="UniformToFill" />
              <cupertino:CupertinoToolbar>
                <Button ToolTip.Tip="Back">
                  <cupertino:CupertinoIcon Glyph="chevron.left" Size="20" />
                </Button>
                <Button ToolTip.Tip="Forward">
                  <cupertino:CupertinoIcon Glyph="chevron.right" Size="20" />
                </Button>
                <cupertino:ToolbarSpacer />
                <Button ToolTip.Tip="Search">
                  <cupertino:CupertinoIcon Glyph="magnifyingglass" Size="20" />
                </Button>
                <cupertino:ToolbarSpacer />
                <Button ToolTip.Tip="Library">
                  <cupertino:CupertinoIcon Glyph="square.stack" Size="20" />
                </Button>
              </cupertino:CupertinoToolbar>
            </Panel>
          </Border>
        </Grid>
      </cupertino:Section>

      <cupertino:Section Header="ONE GROUP"
                         Footer="Leave out the spacer to keep all actions together on one glass background.">
        <Grid Margin="16,11">
          <Border CornerRadius="10" ClipToBounds="True" Height="220">
            <Panel>
              <Image Source="avares://Cupertino.Gallery/Assets/Photos/canyon.jpg"
                     Stretch="UniformToFill" />
              <cupertino:CupertinoToolbar>
              <Button ToolTip.Tip="Play">
                <cupertino:CupertinoIcon Glyph="play" Size="20" />
              </Button>
              <Button ToolTip.Tip="Pause">
                <cupertino:CupertinoIcon Glyph="pause" Size="20" />
              </Button>
              <Button ToolTip.Tip="Forward">
                <cupertino:CupertinoIcon Glyph="forward" Size="20" />
              </Button>
              </cupertino:CupertinoToolbar>
            </Panel>
          </Border>
        </Grid>
      </cupertino:Section>

    </StackPanel>
  </ScrollViewer>
</UserControl>
