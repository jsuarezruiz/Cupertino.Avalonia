<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cupertino="https://cupertino.avaloniaui.net"
             xmlns:local="using:Cupertino.Gallery"
             x:Class="Cupertino.Gallery.Pages.NotificationsPage">

  <ScrollViewer>
    <StackPanel Margin="0,74,0,120">

      <cupertino:Section Header="BASIC"
                         Footer="Show a notification banner at the top of the window. It closes automatically after a short time.">
        <StackPanel>
        <Grid Classes="case" ColumnDefinitions="Auto,*">
          <TextBlock Classes="case" Text="Show" />
          <WrapPanel Grid.Column="1" Classes="specimens">
            <Button Content="Show banner" Click="OnInfo" />
          </WrapPanel>
        </Grid>
        </StackPanel>
      </cupertino:Section>

      <cupertino:Section Header="TYPES"
                         Footer="Compare information, success, warning, and error notifications. Each uses a different colour for its indicator.">
        <StackPanel>
        <Grid Classes="case" ColumnDefinitions="Auto,*">
          <TextBlock Classes="case" Text="Type" />
          <WrapPanel Grid.Column="1" Classes="specimens">
            <Button Content="Info" Click="OnInfo" />
            <Button Content="Success" Click="OnSuccess" />
            <Button Content="Warning" Click="OnWarning" />
            <Button Content="Error" Click="OnError" />
          </WrapPanel>
        </Grid>
        </StackPanel>
      </cupertino:Section>

      <cupertino:Section Header="DURATION"
                         Footer="Set Expiration to control how long a notification stays visible. TimeSpan.Zero keeps it open until dismissed. Hover over a banner to reveal its close button.">
        <StackPanel>
        <Grid Classes="case" ColumnDefinitions="Auto,*">
          <TextBlock Classes="case" Text="Timing" />
          <WrapPanel Grid.Column="1" Classes="specimens">
            <Button Content="Quick (2 s)" Click="OnQuick" />
            <Button Content="Slow (10 s)" Click="OnSlow" />
            <Button Content="Sticky" Click="OnSticky" />
          </WrapPanel>
        </Grid>
        </StackPanel>
      </cupertino:Section>

      <cupertino:Section Header="CUSTOM CONTENT"
                         Footer="Pass a control to Show to create a notification with your own layout, such as this music preview.">
        <StackPanel>
        <Grid Classes="case" ColumnDefinitions="Auto,*">
          <TextBlock Classes="case" Text="Content" />
          <WrapPanel Grid.Column="1" Classes="specimens">
            <Button Content="Now playing…" Click="OnCustomContent" />
          </WrapPanel>
        </Grid>
        </StackPanel>
      </cupertino:Section>

      <cupertino:Section Header="CALLBACKS"
                         Footer="Use OnClick and OnClose to respond when a notification is selected or closed. Try the banner and watch the result below.">
        <StackPanel>
        <Grid Classes="case" ColumnDefinitions="Auto,*">
          <TextBlock Classes="case" Text="Callbacks" />
          <WrapPanel Grid.Column="1" Classes="specimens">
            <Button Content="Show and watch" Click="OnCallbacks" />
          </WrapPanel>
        </Grid>
        <Grid Classes="case" ColumnDefinitions="Auto,*">
          <TextBlock Classes="case" Text="Last event" />
          <TextBlock x:Name="CallbackResult" Grid.Column="1" Text="No event yet"
                     FontSize="15" VerticalAlignment="Center"
                     Foreground="{DynamicResource CupertinoSecondaryLabelBrush}" />
        </Grid>
        </StackPanel>
      </cupertino:Section>

    </StackPanel>
  </ScrollViewer>
</UserControl>
