<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cupertino="https://cupertino.avaloniaui.net"
             x:Class="Cupertino.Gallery.Pages.MaskedTextBoxPage">

  <ScrollViewer>
    <StackPanel Margin="0,74,0,120">

      <cupertino:Section Header="BASIC" Footer="Use an input mask when text must follow a fixed pattern, such as a phone number. In the mask, 0 requires a digit.">
        <StackPanel>
          <Grid Classes="case" ColumnDefinitions="Auto,*">
            <TextBlock Classes="case" Text="Phone" />
            <MaskedTextBox Grid.Column="1" Mask="(000) 000-0000" />
          </Grid>
        </StackPanel>
      </cupertino:Section>

      <cupertino:Section Header="CUSTOMIZED" Footer="Masks can include separators, convert letters to uppercase with &gt;, and show literal characters by escaping them with a backslash.">
        <StackPanel>
          <Grid Classes="case" ColumnDefinitions="Auto,*">
            <TextBlock Classes="case" Text="Date" />
            <MaskedTextBox Grid.Column="1" Mask="00/00/0000" />
          </Grid>
          <Rectangle Classes="hair" />
          <Grid Classes="case" ColumnDefinitions="Auto,*">
            <TextBlock Classes="case" Text="Hex colour" />
            <MaskedTextBox Grid.Column="1" Mask="\#&gt;AAAAAA" />
          </Grid>
        </StackPanel>
      </cupertino:Section>

      <cupertino:Section Header="STATES" Footer="A disabled field keeps its current text but cannot be edited.">
        <StackPanel>
          <Grid Classes="case" ColumnDefinitions="Auto,*">
            <TextBlock Classes="case" Text="Disabled" />
            <MaskedTextBox Grid.Column="1" Mask="(000) 000-0000" IsEnabled="False" />
          </Grid>
        </StackPanel>
      </cupertino:Section>

    </StackPanel>
  </ScrollViewer>
</UserControl>
