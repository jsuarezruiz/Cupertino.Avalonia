<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cupertino="https://cupertino.avaloniaui.net"
             x:Class="Cupertino.Gallery.Pages.CalendarPage">

  <ScrollViewer>
    <StackPanel Margin="0,74,0,120">

      <cupertino:Section Header="BASIC"
                         Footer="Browse months and select a date. The selected day uses the accent colour, while days from adjacent months appear dimmed.">
        <Panel Margin="8,8">
          <Calendar x:Name="DemoCalendar" HorizontalAlignment="Center" />
        </Panel>
      </cupertino:Section>

      <cupertino:Section Header="CUSTOMIZED"
                         Footer="Use MultipleRange selection to choose groups of dates. DisplayDateStart and DisplayDateEnd limit the dates available in the calendar.">
        <StackPanel>
          <Grid Classes="case">
            <StackPanel Spacing="10">
              <TextBlock FontSize="13" Foreground="{DynamicResource CupertinoSecondaryLabelBrush}"
                         Text="Multiple range" />
              <Calendar x:Name="RangeCalendar" SelectionMode="MultipleRange"
                        HorizontalAlignment="Center" />
            </StackPanel>
          </Grid>
          <Rectangle Classes="hair" />
          <Grid Classes="case">
            <StackPanel Spacing="10">
              <TextBlock FontSize="13" Foreground="{DynamicResource CupertinoSecondaryLabelBrush}"
                         Text="Bounded to the current month" />
              <Calendar x:Name="BoundedCalendar" HorizontalAlignment="Center" />
            </StackPanel>
          </Grid>
        </StackPanel>
      </cupertino:Section>

      <cupertino:Section Header="STATES"
                         Footer="Turn off IsTodayHighlighted to hide today's highlight. A disabled calendar cannot be changed through user input.">
        <StackPanel>
          <Grid Classes="case">
            <StackPanel Spacing="10">
              <TextBlock FontSize="13" Foreground="{DynamicResource CupertinoSecondaryLabelBrush}"
                         Text="Today not highlighted" />
              <Calendar IsTodayHighlighted="False" HorizontalAlignment="Center" />
            </StackPanel>
          </Grid>
          <Rectangle Classes="hair" />
          <Grid Classes="case">
            <StackPanel Spacing="10">
              <TextBlock FontSize="13" Foreground="{DynamicResource CupertinoSecondaryLabelBrush}"
                         Text="Disabled" />
              <Calendar x:Name="DisabledCalendar" IsEnabled="False" HorizontalAlignment="Center" />
            </StackPanel>
          </Grid>
        </StackPanel>
      </cupertino:Section>

    </StackPanel>
  </ScrollViewer>
</UserControl>
