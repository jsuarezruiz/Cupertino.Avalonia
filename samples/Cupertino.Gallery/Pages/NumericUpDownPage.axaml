<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cupertino="https://cupertino.avaloniaui.net"
             x:Class="Cupertino.Gallery.Pages.NumericUpDownPage">

  <ScrollViewer>
    <StackPanel Margin="0,74,0,120">

      <cupertino:Section Header="BASIC" Footer="Enter a number or use the minus and plus buttons to adjust it. Minimum and Maximum keep the value within a range.">
        <StackPanel>
          <Grid Classes="case" ColumnDefinitions="Auto,*">
            <TextBlock Classes="case" Text="With value" />
            <WrapPanel Grid.Column="1" Classes="specimens">
              <NumericUpDown Value="3" Minimum="0" Maximum="10" FormatString="0" />
            </WrapPanel>
          </Grid>
        </StackPanel>
      </cupertino:Section>

      <cupertino:Section Header="CUSTOMIZED" Footer="Set Increment to change the step size and FormatString to format the value. The stepper class shows only the minus and plus buttons.">
        <StackPanel>
          <Grid Classes="case" ColumnDefinitions="Auto,*">
            <TextBlock Classes="case" Text="Fractional" />
            <WrapPanel Grid.Column="1" Classes="specimens">
              <NumericUpDown Value="2.5" Increment="0.5" Minimum="0" Maximum="5" FormatString="0.0" />
            </WrapPanel>
          </Grid>
          <Rectangle Classes="hair" />
          <Grid Classes="case" ColumnDefinitions="Auto,*">
            <TextBlock Classes="case" Text="Stepper only" />
            <WrapPanel Grid.Column="1" Classes="specimens">
              <NumericUpDown Classes="stepper" Value="2" Minimum="0" Maximum="10" />
            </WrapPanel>
          </Grid>
        </StackPanel>
      </cupertino:Section>

      <cupertino:Section Header="STATES" Footer="A disabled control shows its current value but cannot be edited or stepped.">
        <StackPanel>
          <Grid Classes="case" ColumnDefinitions="Auto,*">
            <TextBlock Classes="case" Text="Disabled" />
            <WrapPanel Grid.Column="1" Classes="specimens">
              <NumericUpDown Value="3" Minimum="0" Maximum="10" FormatString="0" IsEnabled="False" />
              <NumericUpDown Classes="stepper" Value="0" Minimum="0" Maximum="10" IsEnabled="False" />
            </WrapPanel>
          </Grid>
        </StackPanel>
      </cupertino:Section>

    </StackPanel>
  </ScrollViewer>
</UserControl>
