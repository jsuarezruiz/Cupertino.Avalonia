<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cupertino="https://cupertino.avaloniaui.net"
             x:Class="Cupertino.Gallery.Pages.RefreshContainerPage">

  <ScrollViewer>
    <StackPanel Margin="0,74,0,120">

      <cupertino:Section Header="BASIC"
                         Footer="Scroll to the top of the list, then drag down and release to refresh. Use a touch gesture or drag with the mouse; the mouse wheel only scrolls. The spinner remains visible while the refresh runs.">
        <Grid Classes="case">
          <Border CornerRadius="10" ClipToBounds="True" Height="360"
                  Background="{DynamicResource CupertinoCardBrush}">
            <!-- Enable mouse dragging so desktop users can try the same pull gesture as touch users. -->
            <RefreshContainer x:Name="Refresher" IsMouseEnabled="True"
                              RefreshRequested="OnRefreshRequested">
              <ScrollViewer>
                <StackPanel x:Name="Rows" />
              </ScrollViewer>
            </RefreshContainer>
          </Border>
        </Grid>
      </cupertino:Section>

      <cupertino:Section Header="PROGRAMMATIC"
                         Footer="Use RequestRefresh() to start a refresh from code. The button runs the same refresh as the pull gesture.">
        <Grid Classes="case">
          <Button Content="Refresh now" Click="OnRequestRefresh" />
        </Grid>
      </cupertino:Section>

    </StackPanel>
  </ScrollViewer>
</UserControl>
