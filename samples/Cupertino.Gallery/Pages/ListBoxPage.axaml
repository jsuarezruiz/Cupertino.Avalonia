<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cupertino="https://cupertino.avaloniaui.net"
             x:Class="Cupertino.Gallery.Pages.ListBoxPage">

  <ScrollViewer>
    <StackPanel Margin="0,74,0,120">

      <cupertino:Section Header="BASIC"
                         Footer="Choose an item from the list. A Section supplies the rounded card around these rows.">
        <ListBox SelectionMode="Single" SelectedIndex="0">
          <ListBoxItem Content="First row" />
          <ListBoxItem Content="Second row" />
          <ListBoxItem Content="Third row" />
        </ListBox>
      </cupertino:Section>

      <TextBlock Text="CUSTOMIZED" FontSize="13" TextWrapping="Wrap"
                 Foreground="{DynamicResource CupertinoSecondaryLabelBrush}"
                 Margin="32,0,32,7" />
      <ListBox Classes="inset icons" Margin="16,0" SelectionMode="Single" SelectedIndex="0">
        <ListBoxItem>
          <Grid ColumnDefinitions="29,*">
            <Border Width="29" Height="29" CornerRadius="7"
                    Background="#FF007AFF" VerticalAlignment="Center">
              <TextBlock Text="&#x2726;" FontSize="15" Foreground="White"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Grid.Column="1" Text="Wi-Fi" FontSize="17"
                       Margin="12,0,0,0" VerticalAlignment="Center"
                       Foreground="{DynamicResource CupertinoLabelBrush}" />
          </Grid>
        </ListBoxItem>
        <ListBoxItem>
          <Grid ColumnDefinitions="29,*">
            <Border Width="29" Height="29" CornerRadius="7"
                    Background="#FF34C759" VerticalAlignment="Center">
              <TextBlock Text="&#x26AD;" FontSize="15" Foreground="White"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Grid.Column="1" Text="Personal Hotspot" FontSize="17"
                       Margin="12,0,0,0" VerticalAlignment="Center"
                       Foreground="{DynamicResource CupertinoLabelBrush}" />
          </Grid>
        </ListBoxItem>
        <ListBoxItem>
          <Grid ColumnDefinitions="29,*">
            <Border Width="29" Height="29" CornerRadius="7"
                    Background="#FFFF9500" VerticalAlignment="Center">
              <TextBlock Text="&#x2708;" FontSize="15" Foreground="White"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Grid.Column="1" Text="Airplane Mode" FontSize="17"
                       Margin="12,0,0,0" VerticalAlignment="Center"
                       Foreground="{DynamicResource CupertinoLabelBrush}" />
          </Grid>
        </ListBoxItem>
      </ListBox>
      <TextBlock FontSize="13" TextWrapping="Wrap"
                 Foreground="{DynamicResource CupertinoSecondaryLabelBrush}"
                 Margin="32,7,32,24"
                 Text="Use the inset class to give the list its own rounded card. Add icons for taller rows with separators aligned to the labels." />

      <cupertino:Section Header="STATES"
                         Footer="Use Multiple selection to select more than one item. A disabled row appears dimmed and cannot be selected.">
        <ListBox SelectionMode="Multiple">
          <ListBoxItem Content="Shared album" IsSelected="True" />
          <ListBoxItem Content="Family photos" IsSelected="True" />
          <ListBoxItem Content="Screenshots" />
          <ListBoxItem Content="Hidden" IsEnabled="False" />
        </ListBox>
      </cupertino:Section>

    </StackPanel>
  </ScrollViewer>
</UserControl>
