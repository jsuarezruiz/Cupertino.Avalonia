<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cupertino="https://cupertino.avaloniaui.net"
             xmlns:local="using:Cupertino.Gallery"
             x:Class="Cupertino.Gallery.Pages.TransitioningContentPage">

  <ScrollViewer>
    <StackPanel Margin="0,74,0,120">

      <cupertino:Section Header="BASIC"
                         Footer="Change the content to see it fade into the next view. TransitioningContentControl animates each change to Content.">
        <StackPanel>
          <Grid Classes="case" ColumnDefinitions="Auto,*">
            <TextBlock Classes="case" Text="Default" />
            <TransitioningContentControl x:Name="Stage" Grid.Column="1" Height="60"
                                         VerticalContentAlignment="Center" />
          </Grid>
          <Grid Classes="case">
            <Button Content="Swap content" Click="OnDefaultSwap" />
          </Grid>
        </StackPanel>
      </cupertino:Section>

      <cupertino:Section Header="CUSTOMIZED"
                         Footer="Set PageTransition to choose an animation. Use the button to compare a slower fade with a horizontal slide.">
        <StackPanel>
          <Grid Classes="case" ColumnDefinitions="Auto,*">
            <TextBlock Classes="case" Text="CrossFade" />
            <TransitioningContentControl x:Name="Fade" Grid.Column="1" Height="60"
                                         VerticalContentAlignment="Center">
              <TransitioningContentControl.PageTransition>
                <CrossFade Duration="0:0:0.4" />
              </TransitioningContentControl.PageTransition>
            </TransitioningContentControl>
          </Grid>
          <Rectangle Classes="hair" />
          <Grid Classes="case" ColumnDefinitions="Auto,*">
            <TextBlock Classes="case" Text="PageSlide" />
            <Border Grid.Column="1" ClipToBounds="True">
              <TransitioningContentControl x:Name="Slide" Height="60"
                                           VerticalContentAlignment="Center">
                <TransitioningContentControl.PageTransition>
                  <PageSlide Duration="0:0:0.3" Orientation="Horizontal" />
                </TransitioningContentControl.PageTransition>
              </TransitioningContentControl>
            </Border>
          </Grid>
          <Grid Classes="case">
            <Button Content="Swap content" Click="OnCustomizedSwap" />
          </Grid>
        </StackPanel>
      </cupertino:Section>

    </StackPanel>
  </ScrollViewer>
</UserControl>
