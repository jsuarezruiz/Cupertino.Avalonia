<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cupertino="https://cupertino.avaloniaui.net"
             xmlns:local="using:Cupertino.Gallery"
             x:Class="Cupertino.Gallery.Pages.DatePickerPage">

  <ScrollViewer>
    <StackPanel Margin="0,74,0,120">

      <cupertino:Section Header="BASIC"
                         Footer="Select the date field to open a calendar and choose a date.">
        <StackPanel>
          <Grid Classes="case" ColumnDefinitions="Auto,*">
            <TextBlock Classes="case" Text="Date" />
            <WrapPanel Grid.Column="1" Classes="specimens">
              <cupertino:CupertinoDatePicker x:Name="DemoDate" />
            </WrapPanel>
          </Grid>
        </StackPanel>
      </cupertino:Section>

      <cupertino:Section Header="CUSTOMIZED"
                         Footer="Place date and time fields together when users need to choose both, such as when scheduling an event.">
        <StackPanel>
          <Grid Classes="case" ColumnDefinitions="Auto,*">
            <TextBlock Classes="case" Text="Date and time" />
            <cupertino:CupertinoDateTimePicker x:Name="DemoDateTime" Grid.Column="1"
                                              HorizontalAlignment="Right" />
          </Grid>
          <Grid Classes="case" RowDefinitions="Auto,Auto" RowSpacing="8">
            <TextBlock Classes="case" Text="Inline bounded" />
            <cupertino:CupertinoDatePicker x:Name="DemoInlineDate" Grid.Row="1"
                                           DisplayMode="Inline" HorizontalAlignment="Center" />
          </Grid>
        </StackPanel>
      </cupertino:Section>

      <cupertino:Section Header="AVALONIA DATEPICKER"
                         Footer="Avalonia's standard DatePicker uses the Cupertino appearance and opens its own column-based picker.">
        <StackPanel>
          <Grid Classes="case" ColumnDefinitions="Auto,*">
            <TextBlock Classes="case" Text="Stock control" />
            <WrapPanel Grid.Column="1" Classes="specimens">
              <DatePicker />
            </WrapPanel>
          </Grid>
        </StackPanel>
      </cupertino:Section>

      <cupertino:Section Header="STATES"
                         Footer="A disabled field shows its current date but cannot open the picker.">
        <StackPanel>
          <Grid Classes="case" ColumnDefinitions="Auto,*">
            <TextBlock Classes="case" Text="Disabled" />
            <WrapPanel Grid.Column="1" Classes="specimens">
              <cupertino:CupertinoDatePicker x:Name="DemoDateOff" IsEnabled="False" />
            </WrapPanel>
          </Grid>
        </StackPanel>
      </cupertino:Section>

    </StackPanel>
  </ScrollViewer>
</UserControl>
