<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cupertino="https://cupertino.avaloniaui.net"
             x:Class="Cupertino.Gallery.ControlsPage">

  <ScrollViewer>
    <StackPanel Margin="0,58,0,120">

      <TextBlock Text="Controls" FontSize="34" FontWeight="Bold"
                 Foreground="{DynamicResource CupertinoLabelBrush}"
                 Margin="20,0,20,2" />
      <TextBlock Text="Every control, with its main cases."
                 FontSize="15" Margin="20,0,20,22"
                 Foreground="{DynamicResource CupertinoSecondaryLabelBrush}" />

      <cupertino:Section Header="BUTTON"
                         Footer="Default renders on live glass. Style classes: prominent, bordered, plain, small, large.">
        <StackPanel>
          <Grid Classes="case" ColumnDefinitions="Auto,*">
            <TextBlock Classes="case" Text="Glass" />
            <WrapPanel Grid.Column="1" Classes="specimens">
              <Button Content="Glass" />
              <Button Content="Prominent" Classes="prominent" />
            </WrapPanel>
          </Grid>
          <Rectangle Classes="hair" />
          <Grid Classes="case" ColumnDefinitions="Auto,*">
            <TextBlock Classes="case" Text="Flat" />
            <WrapPanel Grid.Column="1" Classes="specimens">
              <Button Content="Bordered" Classes="bordered" />
              <Button Content="Plain" Classes="plain" />
            </WrapPanel>
          </Grid>
          <Rectangle Classes="hair" />
          <Grid Classes="case" ColumnDefinitions="Auto,*">
            <TextBlock Classes="case" Text="Sizes" />
            <WrapPanel Grid.Column="1" Classes="specimens">
              <Button Content="Small" Classes="small" />
              <Button Content="Regular" />
              <Button Content="Large" Classes="large prominent" />
            </WrapPanel>
          </Grid>
          <Rectangle Classes="hair" />
          <Grid Classes="case" ColumnDefinitions="Auto,*">
            <TextBlock Classes="case" Text="Disabled" />
            <WrapPanel Grid.Column="1" Classes="specimens">
              <Button Content="Glass" IsEnabled="False" />
              <Button Content="Prominent" Classes="prominent" IsEnabled="False" />
            </WrapPanel>
          </Grid>
        </StackPanel>
      </cupertino:Section>

      <cupertino:Section Header="TOGGLESWITCH"
                         Footer="63×28pt track, 37×24pt capsule knob. Drag the knob: the track colour follows it.">
        <StackPanel>
          <Grid Classes="case" ColumnDefinitions="Auto,*">
            <TextBlock Classes="case" Text="States" />
            <WrapPanel Grid.Column="1" Classes="specimens">
              <ToggleSwitch IsChecked="True" />
              <ToggleSwitch IsChecked="False" />
              <ToggleSwitch IsChecked="True" IsEnabled="False" />
            </WrapPanel>
          </Grid>
          <Rectangle Classes="hair" />
          <Grid Classes="case" ColumnDefinitions="Auto,*">
            <TextBlock Classes="case" Text="With label" />
            <WrapPanel Grid.Column="1" Classes="specimens">
              <ToggleSwitch Content="Wi-Fi" IsChecked="True" />
            </WrapPanel>
          </Grid>
        </StackPanel>
      </cupertino:Section>

      <cupertino:Section Header="SLIDER"
                         Footer="5.7pt rail, 37×24pt thumb, the same capsule the switch uses.">
        <StackPanel>
          <Grid Classes="case" ColumnDefinitions="Auto,*">
            <TextBlock Classes="case" Text="Value" />
            <Slider Grid.Column="1" Value="35" Maximum="100" VerticalAlignment="Center" />
          </Grid>
          <Rectangle Classes="hair" />
          <Grid Classes="case" ColumnDefinitions="Auto,*">
            <TextBlock Classes="case" Text="Steps" />
            <Slider Grid.Column="1" Value="60" Maximum="100" TickFrequency="20"
                    IsSnapToTickEnabled="True" VerticalAlignment="Center" />
          </Grid>
          <Rectangle Classes="hair" />
          <Grid Classes="case" ColumnDefinitions="Auto,*">
            <TextBlock Classes="case" Text="Disabled" />
            <Slider Grid.Column="1" Value="50" Maximum="100" IsEnabled="False" VerticalAlignment="Center" />
          </Grid>
        </StackPanel>
      </cupertino:Section>

      <cupertino:Section Header="TEXTBOX"
                         Footer="Classes: plain for list rows, search for a search field, glass to render on live glass.">
        <StackPanel Margin="16,12" Spacing="10">
          <TextBox PlaceholderText="Bordered field" />
          <TextBox Text="Typed value" />
          <TextBox PlaceholderText="Read-only" Text="Locked" IsReadOnly="True" />
          <TextBox Classes="search" PlaceholderText="Search" />
          <TextBox Classes="search" Text="query" PlaceholderText="Search" />
          <TextBox PlaceholderText="Disabled" IsEnabled="False" />
        </StackPanel>
      </cupertino:Section>

      <cupertino:Section Header="CHECKBOX &amp; RADIOBUTTON"
                         Footer="iOS has no standalone checkbox; these follow the Reminders idiom: a filled circle with a checkmark.">
        <StackPanel Margin="16,12" Spacing="10">
          <CheckBox Content="Checked" IsChecked="True" />
          <CheckBox Content="Unchecked" />
          <CheckBox Content="Mixed" IsThreeState="True" IsChecked="{x:Null}" />
          <CheckBox Content="Disabled" IsChecked="True" IsEnabled="False" />
          <Rectangle Classes="hair" Margin="0,4" />
          <RadioButton Content="Option one" GroupName="demo" IsChecked="True" />
          <RadioButton Content="Option two" GroupName="demo" />
          <RadioButton Content="Disabled" GroupName="demo" IsEnabled="False" />
        </StackPanel>
      </cupertino:Section>

      <cupertino:Section Header="COMBOBOX"
                         Footer="ComboBox renders as the iOS menu button: accent label plus a chevron.up.chevron.down, with a thick-material dropdown.">
        <StackPanel>
          <Grid Classes="case" ColumnDefinitions="Auto,*">
            <TextBlock Classes="case" Text="Picker" />
            <ComboBox Grid.Column="1" SelectedIndex="1" HorizontalAlignment="Right">
              <ComboBoxItem Content="Small" />
              <ComboBoxItem Content="Medium" />
              <ComboBoxItem Content="Large" />
            </ComboBox>
          </Grid>
          <Rectangle Classes="hair" />
          <Grid Classes="case" ColumnDefinitions="Auto,*">
            <TextBlock Classes="case" Text="In a row" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
              <TextBlock Text="Quality" FontSize="17" VerticalAlignment="Center"
                         Foreground="{DynamicResource CupertinoLabelBrush}" />
              <ComboBox SelectedIndex="0">
                <ComboBoxItem Content="Automatic" />
                <ComboBoxItem Content="High" />
                <ComboBoxItem Content="Low" />
              </ComboBox>
            </StackPanel>
          </Grid>
          <Rectangle Classes="hair" />
          <Grid Classes="case" ColumnDefinitions="Auto,*">
            <TextBlock Classes="case" Text="Disabled" />
            <ComboBox Grid.Column="1" SelectedIndex="0" IsEnabled="False" HorizontalAlignment="Right">
              <ComboBoxItem Content="Unavailable" />
            </ComboBox>
          </Grid>
        </StackPanel>
      </cupertino:Section>

      <cupertino:Section Header="CUPERTINONAVIGATIONBAR"
                         Footer="Large title collapsing to an inline one over 68pt of scroll. CollapseProgress is settable, so both ends are shown here without a scroller; bind Scroller to drive it from real content.">
        <StackPanel Spacing="10" Margin="0,8,0,12">
          <Border Background="{DynamicResource CupertinoGroupedBackgroundBrush}"
                  CornerRadius="10" ClipToBounds="True" Height="168">
            <cupertino:CupertinoNavigationBar Title="Settings" CollapseProgress="0">
              <cupertino:CupertinoNavigationBar.LeadingContent>
                <Button Content="Edit" Classes="plain" />
              </cupertino:CupertinoNavigationBar.LeadingContent>
              <cupertino:CupertinoNavigationBar.TrailingContent>
                <Button Content="+" Classes="plain" />
              </cupertino:CupertinoNavigationBar.TrailingContent>
            </cupertino:CupertinoNavigationBar>
          </Border>

          <Border Background="{DynamicResource CupertinoGroupedBackgroundBrush}"
                  CornerRadius="10" ClipToBounds="True" Height="116">
            <cupertino:CupertinoNavigationBar Title="Settings" CollapseProgress="1">
              <cupertino:CupertinoNavigationBar.LeadingContent>
                <Button Content="Edit" Classes="plain" />
              </cupertino:CupertinoNavigationBar.LeadingContent>
              <cupertino:CupertinoNavigationBar.TrailingContent>
                <Button Content="+" Classes="plain" />
              </cupertino:CupertinoNavigationBar.TrailingContent>
            </cupertino:CupertinoNavigationBar>
          </Border>
        </StackPanel>
      </cupertino:Section>

      <cupertino:Section Header="REPEATBUTTON, TOGGLEBUTTON, SPLITBUTTON, DROPDOWNBUTTON, HYPERLINKBUTTON"
                         Footer="RepeatButton, ToggleButton, SplitButton, DropDownButton and HyperlinkButton all take the capsule, so reaching for one does not drop Fluent styling into the app.">
        <StackPanel>
          <Grid Classes="case" ColumnDefinitions="Auto,*">
            <TextBlock Classes="case" Text="Repeat" />
            <WrapPanel Grid.Column="1" Classes="specimens">
              <RepeatButton Content="Hold me" />
              <RepeatButton Content="Off" IsEnabled="False" />
            </WrapPanel>
          </Grid>
          <Rectangle Classes="hair" />
          <Grid Classes="case" ColumnDefinitions="Auto,*">
            <TextBlock Classes="case" Text="Toggle" />
            <WrapPanel Grid.Column="1" Classes="specimens">
              <ToggleButton Content="Off" />
              <ToggleButton Content="On" IsChecked="True" />
            </WrapPanel>
          </Grid>
          <Rectangle Classes="hair" />
          <Grid Classes="case" ColumnDefinitions="Auto,*">
            <TextBlock Classes="case" Text="Toggle states" />
            <WrapPanel Grid.Column="1" Classes="specimens">
              <ToggleButton Content="Mixed" IsThreeState="True" IsChecked="{x:Null}" />
              <ToggleButton Content="Disabled" IsChecked="True" IsEnabled="False" />
            </WrapPanel>
          </Grid>
          <Rectangle Classes="hair" />
          <Grid Classes="case" ColumnDefinitions="Auto,*">
            <TextBlock Classes="case" Text="Split" />
            <WrapPanel Grid.Column="1" Classes="specimens">
              <SplitButton Content="Share">
                <SplitButton.Flyout>
                  <MenuFlyout>
                    <MenuItem Header="Copy Link" />
                    <MenuItem Header="AirDrop" />
                    <Separator />
                    <MenuItem Header="Remove" Classes="destructive" />
                  </MenuFlyout>
                </SplitButton.Flyout>
              </SplitButton>
            </WrapPanel>
          </Grid>
          <Rectangle Classes="hair" />
          <Grid Classes="case" ColumnDefinitions="Auto,*">
            <TextBlock Classes="case" Text="Drop-down" />
            <WrapPanel Grid.Column="1" Classes="specimens">
              <DropDownButton Content="Sort">
                <DropDownButton.Flyout>
                  <MenuFlyout>
                    <MenuItem Header="Name" />
                    <MenuItem Header="Date" />
                    <MenuItem Header="Size" />
                  </MenuFlyout>
                </DropDownButton.Flyout>
              </DropDownButton>
            </WrapPanel>
          </Grid>
          <Rectangle Classes="hair" />
          <Grid Classes="case" ColumnDefinitions="Auto,*">
            <TextBlock Classes="case" Text="Link" />
            <WrapPanel Grid.Column="1" Classes="specimens">
              <HyperlinkButton Content="Learn more" />
              <HyperlinkButton Content="Unavailable" IsEnabled="False" />
            </WrapPanel>
          </Grid>
        </StackPanel>
      </cupertino:Section>

      <cupertino:Section Header="CALENDAR"
                         Footer="Avalonia's Calendar with Cupertino styling, accent selection and subdued adjacent months.">
        <Panel Margin="8,8">
          <Calendar x:Name="DemoCalendar" HorizontalAlignment="Center" />
        </Panel>
      </cupertino:Section>

      <cupertino:Section Header="EXPANDER"
                         Footer="Expander renders as an iOS disclosure group: a 52pt row whose chevron turns down, with the revealed rows indented 21pt.">
        <StackPanel>
          <Expander Header="Wi-Fi Networks" Margin="16,0">
            <StackPanel>
              <Panel Height="52">
                <TextBlock Text="Home" FontSize="17" VerticalAlignment="Center"
                           Foreground="{DynamicResource CupertinoLabelBrush}" />
              </Panel>
              <Rectangle Height="0.5" Fill="{DynamicResource CupertinoSeparatorBrush}" />
              <Panel Height="52">
                <TextBlock Text="Office" FontSize="17" VerticalAlignment="Center"
                           Foreground="{DynamicResource CupertinoLabelBrush}" />
              </Panel>
            </StackPanel>
          </Expander>
          <Rectangle Classes="hair" />
          <Expander Header="Advanced" Margin="16,0" IsExpanded="True">
            <Panel Height="52">
              <TextBlock Text="Private Wi-Fi Address" FontSize="17" VerticalAlignment="Center"
                         Foreground="{DynamicResource CupertinoLabelBrush}" />
            </Panel>
          </Expander>
        </StackPanel>
      </cupertino:Section>

      <cupertino:Section Header="CUPERTINODATEPICKER &amp; CUPERTINOTIMEPICKER"
                         Footer="Compact fields are capsules in iOS 26. Tapping a date opens a calendar; tapping a time opens the wheel, which spins, flings and settles, and a tap on any visible row scrolls it into the selection.">
        <StackPanel>
          <Grid Classes="case" ColumnDefinitions="Auto,*">
            <TextBlock Classes="case" Text="Date" />
            <WrapPanel Grid.Column="1" Classes="specimens">
              <cupertino:CupertinoDatePicker x:Name="DemoDate" />
            </WrapPanel>
          </Grid>
          <Rectangle Classes="hair" />
          <Grid Classes="case" ColumnDefinitions="Auto,*">
            <TextBlock Classes="case" Text="Time" />
            <WrapPanel Grid.Column="1" Classes="specimens">
              <cupertino:CupertinoTimePicker x:Name="DemoTime" />
            </WrapPanel>
          </Grid>
          <Rectangle Classes="hair" />
          <Grid Classes="case" ColumnDefinitions="Auto,*">
            <TextBlock Classes="case" Text="Date and time" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4"
                        HorizontalAlignment="Right" VerticalAlignment="Center">
              <cupertino:CupertinoDatePicker x:Name="DemoBothDate" />
              <cupertino:CupertinoTimePicker x:Name="DemoBothTime" />
            </StackPanel>
          </Grid>
          <Rectangle Classes="hair" />
          <Grid Classes="case" ColumnDefinitions="Auto,*">
            <TextBlock Classes="case" Text="24-hour, 5 min" />
            <WrapPanel Grid.Column="1" Classes="specimens">
              <cupertino:CupertinoTimePicker x:Name="DemoTime24"
                                             ClockIdentifier="24HourClock"
                                             MinuteIncrement="5" />
            </WrapPanel>
          </Grid>
          <Rectangle Classes="hair" />
          <Grid Classes="case" ColumnDefinitions="Auto,*">
            <TextBlock Classes="case" Text="Disabled" />
            <WrapPanel Grid.Column="1" Classes="specimens">
              <cupertino:CupertinoDatePicker x:Name="DemoDateOff" IsEnabled="False" />
            </WrapPanel>
          </Grid>
        </StackPanel>
      </cupertino:Section>

      <cupertino:Section Header="NUMERICUPDOWN &amp; CONTEXTMENU"
                         Footer="NumericUpDown renders the iOS stepper; add Classes=&quot;stepper&quot; to drop the text field. Right-click the row below for the menu.">
        <StackPanel>
          <Grid Classes="case" ColumnDefinitions="Auto,*">
            <TextBlock Classes="case" Text="With value" />
            <WrapPanel Grid.Column="1" Classes="specimens">
              <NumericUpDown Value="3" Minimum="0" Maximum="10" />
            </WrapPanel>
          </Grid>
          <Rectangle Classes="hair" />
          <Grid Classes="case" ColumnDefinitions="Auto,*">
            <TextBlock Classes="case" Text="Stepper only" />
            <WrapPanel Grid.Column="1" Classes="specimens">
              <NumericUpDown Classes="stepper" Value="2" Minimum="0" Maximum="10" />
              <NumericUpDown Classes="stepper" Value="0" Minimum="0" Maximum="10" IsEnabled="False" />
            </WrapPanel>
          </Grid>
          <Rectangle Classes="hair" />
          <Grid Classes="case" ColumnDefinitions="Auto,*" Height="52">
            <TextBlock Classes="case" Text="Context menu" />
            <Border Grid.Column="1" Background="Transparent">
              <TextBlock Text="Right-click me" FontSize="17" VerticalAlignment="Center"
                         Foreground="{DynamicResource CupertinoSecondaryLabelBrush}" />
              <Border.ContextMenu>
                <ContextMenu>
                  <MenuItem Header="Duplicate" />
                  <MenuItem Header="Rename" />
                  <Separator />
                  <MenuItem Header="Delete" Classes="destructive" />
                </ContextMenu>
              </Border.ContextMenu>
            </Border>
          </Grid>
        </StackPanel>
      </cupertino:Section>

      <cupertino:Section Header="PROGRESSBAR"
                         Footer="4pt capsule over a system-fill track.">
        <StackPanel>
          <Grid Classes="case" ColumnDefinitions="Auto,*">
            <TextBlock Classes="case" Text="Determinate" />
            <ProgressBar Grid.Column="1" Value="60" Maximum="100" VerticalAlignment="Center" />
          </Grid>
          <Rectangle Classes="hair" />
          <Grid Classes="case" ColumnDefinitions="Auto,*">
            <TextBlock Classes="case" Text="Indeterminate" />
            <ProgressBar Grid.Column="1" IsIndeterminate="True" VerticalAlignment="Center" />
          </Grid>
        </StackPanel>
      </cupertino:Section>

      <cupertino:Section Header="TABCONTROL &amp; TABSTRIP"
                         Footer="TabControl Classes=&quot;segmented&quot; when segments own pages; TabStrip when they do not.">
        <StackPanel Margin="16,14" Spacing="12">
          <TabControl Classes="segmented" SelectedIndex="1">
            <TabItem Header="Years" />
            <TabItem Header="Months" />
            <TabItem Header="Days" />
          </TabControl>
          <TabStrip Classes="segmented" SelectedIndex="0">
            <TabStripItem Content="Strip" />
            <TabStripItem Content="No pages" />
          </TabStrip>
        </StackPanel>
      </cupertino:Section>

      <cupertino:Section Header="LISTBOX"
                         Footer="A plain ListBox inside a Section; add Classes=&quot;icons&quot; when rows carry a 29pt tile.">
        <ListBox SelectionMode="Single" SelectedIndex="0">
          <ListBoxItem Content="First row" />
          <ListBoxItem Content="Second row" />
          <ListBoxItem Content="Third row" />
        </ListBox>
      </cupertino:Section>

      <cupertino:Section Header="DIALOG"
                         Footer="Hosted in the window's overlay layer, so the glass samples the app behind it.">
        <StackPanel>
          <Grid Classes="case" ColumnDefinitions="Auto,*">
            <TextBlock Classes="case" Text="Alert" />
            <WrapPanel Grid.Column="1" Classes="specimens">
              <Button Content="Delete Photo…" Classes="bordered" Click="OnAlert" />
            </WrapPanel>
          </Grid>
          <Rectangle Classes="hair" />
          <Grid Classes="case" ColumnDefinitions="Auto,*">
            <TextBlock Classes="case" Text="Action sheet" />
            <WrapPanel Grid.Column="1" Classes="specimens">
              <Button Content="Photo options…" Classes="bordered" Click="OnSheet" />
            </WrapPanel>
          </Grid>
        </StackPanel>
      </cupertino:Section>

    </StackPanel>
  </ScrollViewer>
</UserControl>
