<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cupertino="https://cupertino.avaloniaui.net"
             xmlns:local="using:Cupertino.Gallery"
             x:Class="Cupertino.Gallery.RootPage"
             x:DataType="local:RootPage">

  <UserControl.Styles>
    <Style Selector="cupertino|Section.desktop-search-host">
      <Setter Property="Margin" Value="0,0,0,16" />
    </Style>
    <Style Selector="cupertino|Section.desktop-search-host /template/ Border#Card">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="ClipToBounds" Value="False" />
    </Style>
    <Style Selector="cupertino|Section.desktop-search-host TextBox#Filter">
      <Setter Property="Width" Value="296" />
      <Setter Property="Margin" Value="0,8" />
      <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.highlight-title">
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource CupertinoLabelBrush}" />
    </Style>
    <Style Selector="TextBlock.highlight-body">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Foreground" Value="{DynamicResource CupertinoSecondaryLabelBrush}" />
    </Style>
  </UserControl.Styles>

  <UserControl.Resources>
    <DataTemplate x:Key="EntryTemplate" x:DataType="local:CatalogEntry">
      <Grid ColumnDefinitions="29,*,Auto" Height="52">
        <Border Width="29" Height="29" CornerRadius="7"
                Background="{Binding TileBrush}" VerticalAlignment="Center">
          <TextBlock Text="{Binding Glyph}" FontSize="17" FontWeight="Medium"
                     Foreground="White"
                     HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="17"
                   Margin="12,0,0,0" VerticalAlignment="Center"
                   Foreground="{DynamicResource CupertinoLabelBrush}" />
        <Path Grid.Column="2"
              Data="{StaticResource CupertinoChevronRightGeometry}"
              Stroke="{DynamicResource CupertinoTertiaryLabelBrush}"
              StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round"
              Width="16" Height="16" Stretch="None"
              VerticalAlignment="Center" />
      </Grid>
    </DataTemplate>
  </UserControl.Resources>

  <ScrollViewer>
    <StackPanel Margin="0,113,0,120">

      <cupertino:Section x:Name="HeroSection">
        <Panel x:Name="Hero" Height="188" Margin="16,14" Background="Transparent">
          <Panel.Transitions>
            <Transitions>
              <DoubleTransition Property="Opacity" Duration="0:0:0.12" />
            </Transitions>
          </Panel.Transitions>
          <Border CornerRadius="18" ClipToBounds="True">
            <Panel>
              <Border>
                <Border.Background>
                  <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                    <GradientStop Offset="0.0" Color="#FF3A1C71" />
                    <GradientStop Offset="0.5" Color="#FFD76D77" />
                    <GradientStop Offset="1.0" Color="#FFFFAF7B" />
                  </LinearGradientBrush>
                </Border.Background>
              </Border>
              <Ellipse Width="150" Height="150" Margin="-40,-30,0,0"
                       HorizontalAlignment="Left" VerticalAlignment="Top" Opacity="0.7">
                <Ellipse.Fill>
                  <RadialGradientBrush>
                    <GradientStop Offset="0" Color="#FF4CC2FF" />
                    <GradientStop Offset="1" Color="#0000C2FF" />
                  </RadialGradientBrush>
                </Ellipse.Fill>
              </Ellipse>
            </Panel>
          </Border>

          <cupertino:GlassSurface CornerRadius="20"
                                  Width="236" Height="116"
                                  BlurRadius="24" GlassThickness="11"
                                  RefractionStrength="18" ChromaticAberration="0.5"
                                  DepthEffect="0.28" Saturation="1.3"
                                  LightIntensity="0.9" FresnelStrength="1.2"
                                  ShadowOpacity="0.26" ShadowBlur="28" ShadowOffset="10">
            <StackPanel Margin="18,16" Spacing="6">
              <TextBlock Text="Cupertino" FontSize="17" FontWeight="SemiBold"
                         Foreground="White" />
              <TextBlock Text="An iOS design system for Avalonia: controls, typography, colour, motion and Liquid Glass."
                         FontSize="12" TextWrapping="Wrap" Foreground="#D9FFFFFF" />
            </StackPanel>
          </cupertino:GlassSurface>

          <TextBlock x:Name="HeroVersion" FontSize="11" Foreground="#CCFFFFFF"
                     HorizontalAlignment="Right" VerticalAlignment="Bottom"
                     Margin="0,0,14,10" />
        </Panel>
      </cupertino:Section>

      <cupertino:Section x:Name="SearchSection">
        <TextBox x:Name="Filter" Classes="search" Margin="16,10"
                 PlaceholderText="Search"
                 TextChanged="OnFilterChanged" />
      </cupertino:Section>

      <cupertino:Section x:Name="HighlightsSection" Header="HIGHLIGHTS">
        <StackPanel>
          <StackPanel Margin="16,10" Spacing="10">
            <StackPanel Spacing="2">
              <TextBlock Classes="highlight-title" Text="Input controls" />
              <TextBlock Classes="highlight-body"
                         Text="Avalonia controls with the iOS feel." />
            </StackPanel>
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="24">
              <Slider Width="170" Minimum="0" Maximum="100" Value="64"
                      HorizontalAlignment="Left" />
              <ToggleSwitch Grid.Column="1" IsChecked="True" />
            </Grid>
          </StackPanel>

          <Rectangle Classes="hair" />

          <StackPanel Margin="16,10" Spacing="10">
            <StackPanel Spacing="2">
              <TextBlock Classes="highlight-title" Text="Pickers" />
              <TextBlock Classes="highlight-body"
                         Text="Compact date and time fields open a calendar and wheel." />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="4"
                        HorizontalAlignment="Right">
              <cupertino:CupertinoDatePicker x:Name="HighlightDate" />
              <cupertino:CupertinoTimePicker x:Name="HighlightTime" />
            </StackPanel>
          </StackPanel>

          <Rectangle Classes="hair" />

          <Grid Height="64" ColumnDefinitions="*,Auto" Margin="16,0">
            <StackPanel Spacing="2" VerticalAlignment="Center">
              <TextBlock Classes="highlight-title" Text="Presentation" />
              <TextBlock Classes="highlight-body"
                         Text="Real overlay surfaces." />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                        VerticalAlignment="Center">
              <Button Classes="small" Content="Dialog" Click="OnHighlightDialog" />
              <Button Classes="small prominent" Content="Sheet" Click="OnHighlightSheet" />
            </StackPanel>
          </Grid>
        </StackPanel>
      </cupertino:Section>

      <cupertino:Section x:Name="ControlsSection" Header="CONTROLS"
                         Footer="Open a control to explore its common uses, appearance options, and states.">
        <ListBox x:Name="Catalog"
                 ItemsSource="{Binding ControlEntries}"
                 ItemTemplate="{StaticResource EntryTemplate}"
                 SelectionMode="Single"
                 SelectionChanged="OnSelectionChanged">
          <!-- Virtualisation cannot measure inside Section's StackPanel. -->
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel />
            </ItemsPanelTemplate>
          </ListBox.ItemsPanel>
        </ListBox>
      </cupertino:Section>

      <cupertino:Section x:Name="CupertinoSection" Header="CUPERTINO CONTROLS"
                         Footer="Explore the additional controls provided by this library, including navigation, pickers, and toolbars.">
        <ListBox x:Name="CupertinoCatalog"
                 ItemsSource="{Binding CupertinoEntries}"
                 ItemTemplate="{StaticResource EntryTemplate}"
                 SelectionMode="Single"
                 SelectionChanged="OnSelectionChanged">
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel />
            </ItemsPanelTemplate>
          </ListBox.ItemsPanel>
        </ListBox>
      </cupertino:Section>

      <cupertino:Section x:Name="PresentationSection" Header="PRESENTATION"
                         Footer="Try alerts, flyouts, and notification banners that appear over the current page.">
        <ListBox x:Name="PresentationCatalog"
                 ItemsSource="{Binding PresentationEntries}"
                 ItemTemplate="{StaticResource EntryTemplate}"
                 SelectionMode="Single"
                 SelectionChanged="OnSelectionChanged">
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel />
            </ItemsPanelTemplate>
          </ListBox.ItemsPanel>
        </ListBox>
      </cupertino:Section>

      <cupertino:Section x:Name="ShowcasesSection" Header="SHOWCASES"
                         Footer="Explore complete screens built with the library's controls and glass backgrounds.">
        <ListBox x:Name="ShowcasesCatalog"
                 ItemsSource="{Binding ShowcaseEntries}"
                 ItemTemplate="{StaticResource EntryTemplate}"
                 SelectionMode="Single"
                 SelectionChanged="OnSelectionChanged">
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel />
            </ItemsPanelTemplate>
          </ListBox.ItemsPanel>
        </ListBox>
      </cupertino:Section>

      <cupertino:Section x:Name="StylesSection" Header="STYLES"
                         Footer="Browse the text styles, icons, colours, and glass effects used by the controls.">
        <ListBox x:Name="StylesCatalog"
                 ItemsSource="{Binding StyleEntries}"
                 ItemTemplate="{StaticResource EntryTemplate}"
                 SelectionMode="Single"
                 SelectionChanged="OnSelectionChanged">
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel />
            </ItemsPanelTemplate>
          </ListBox.ItemsPanel>
        </ListBox>
      </cupertino:Section>

    </StackPanel>
  </ScrollViewer>
</UserControl>
